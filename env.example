# =============================================================================
# ENVIRONMENT CONFIGURATION
# =============================================================================
# Copy this file to .env and fill in your values.
# Never commit .env to version control.
# =============================================================================


# =============================================================================
# DATABASE
# =============================================================================

# Primary MySQL connection string.
# Format: mysql://USER:PASSWORD@HOST:PORT/DATABASE
# Connection pool is automatically configured:
#   - connection_limit: 60  (override via DB_CONNECTION_LIMIT or ?connection_limit=...)
#   - pool_timeout:     30s (override via DB_POOL_TIMEOUT or ?pool_timeout=...)
#   - connect_timeout:  10s
DATABASE_URL="mysql://root:root@localhost:3306/xproxy_tester"

# Optional pool tuning (used when DATABASE_URL does not already include these query params)
# Three separate pools prevent background jobs from starving write workers:
#   writeDb       — direct write path + batch-writer (INSERT-heavy)
#   backgroundDb  — aggregation, archival, snapshots
#   prisma        — API reads, health checks (DB_CONNECTION_LIMIT below)
DB_WRITE_CONNECTION_LIMIT=20
DB_BACKGROUND_CONNECTION_LIMIT=8
DB_CONNECTION_LIMIT=15
DB_POOL_TIMEOUT=30
DB_CONNECT_TIMEOUT=10

# Startup schema sync mode:
# - push: run `prisma db push` on app startup (default)
# - off:  skip runtime schema sync (recommended when schema is managed externally)
DB_SCHEMA_SYNC_MODE=push

# Delay (ms) between proxies during app-side streaming aggregation.
# Increase to reduce DB pressure during aggregation; decrease to speed it up.
AGGREGATION_PROXY_DELAY_MS=50

# Number of proxies processed in parallel during app-side daily aggregation.
# Start with 2-4; increase carefully based on DB headroom.
AGGREGATION_PROXY_CONCURRENCY=1

# Page size for per-proxy proxy_requests pagination during aggregation.
# Larger values reduce query round-trips but use more memory per worker.
AGGREGATION_PROXY_REQUEST_PAGE_SIZE=5000

# Max retry attempts (exponential backoff) per aggregation query — groupBy, each proxy_request page, upsert batch, etc.
AGGREGATION_QUERY_MAX_RETRIES=5

# Global DB retry backoff settings (used by retryWithBackoff across the app, including aggregation).
DB_RETRY_INITIAL_DELAY_MS=1000
DB_RETRY_MAX_DELAY_MS=30000
DB_RETRY_LOCK_DELAY_MIN_MS=500
DB_RETRY_LOCK_DELAY_MAX_MS=900

PROXY_REQUEST_BATCH_WRITE_CHUNK_SIZE=200

# Password for the MySQL replication user (used by read replica if configured).
MYSQL_REPLICATION_PASSWORD="replicator_secret_change_me"

# 64-character hex key used to encrypt sensitive fields at rest.
ENCRYPTION_KEY="your-encryption-key-here-64-hex-characters"

# Optional salt used during key derivation. Leave blank to derive from key only.
ENCRYPTION_SALT="optional-salt-for-key-derivation"


# =============================================================================
# XPROXY PORTAL API
# =============================================================================

# Base URL of the XProxy API.
XPROXY_API_URL="https://proxyapi.jumpermedia.co/v2/"

# Endpoint path for fetching the device list.
XPROXY_API_ENDPOINT="/api/devices"

# API token for authenticating requests to the XProxy portal.
XPROXY_API_TOKEN="your-api-token-here"

# Timeout in milliseconds for XProxy API calls.
# Default: 30000 (30s)
XPROXY_API_TIMEOUT_MS=30000

# Credentials used for automated auth-token refresh.
XPROXY_LOGIN_URL="https://proxyapi.jumpermedia.co/v2/auth/login"
XPROXY_LOGIN_EMAIL="admin@jumpermedia.com"
XPROXY_LOGIN_PASSWORD="your-password"


# =============================================================================
# PROXY TESTING
# =============================================================================

# URL used to verify that the proxy is working and to detect the outbound IP.
TEST_TARGET_URL="https://api.ipify.org?format=json"

# How often each proxy is tested, in milliseconds.
# Lower = more granular data but higher DB write volume.
# Default: 10000 (10s). Recommended range: 5000–30000.
TEST_INTERVAL_MS=10000

# Maximum time to wait for a single proxy test request, in milliseconds.
# Default: 15000 (15s)
REQUEST_TIMEOUT_MS=15000

# Number of consecutive failures before a proxy is considered for rotation.
ROTATION_THRESHOLD=10

# How often the proxy list is refreshed from the XProxy API, in milliseconds.
# Default: 21600000 (6 hours)
PROXY_REFRESH_INTERVAL_MS=21600000


# =============================================================================
# STABILITY CALCULATION
# =============================================================================

# How often the stability score is recalculated for each proxy, in milliseconds.
# Default: 1200000 (20 minutes)
STABILITY_CHECK_INTERVAL_MS=1200000


# =============================================================================
# AUTO-DEACTIVATION
# =============================================================================

# Master switch. Set to false to disable automatic proxy deactivation.
AUTO_DEACTIVATION_ENABLED=true

# Deactivate a proxy after this many consecutive failures.
AUTO_DEACTIVATION_CONSECUTIVE_FAILURES=20

# Deactivate a proxy if its failure rate exceeds this threshold (0.0–1.0).
# Evaluated over the last AUTO_DEACTIVATION_FAILURE_RATE_WINDOW requests.
AUTO_DEACTIVATION_FAILURE_RATE=0.9
AUTO_DEACTIVATION_FAILURE_RATE_WINDOW=50


# =============================================================================
# AUTO-RECOVERY
# =============================================================================

# Master switch. Set to false to disable automatic proxy re-activation.
AUTO_RECOVERY_ENABLED=true

# How often deactivated proxies are re-evaluated for recovery, in milliseconds.
# Default: 600000 (10 minutes)
AUTO_RECOVERY_CHECK_INTERVAL_MS=600000

# Number of consecutive successes required before a proxy is re-activated.
AUTO_RECOVERY_CONSECUTIVE_SUCCESSES=5


# =============================================================================
# IP ROTATION (Core Service)
# =============================================================================

# Master switch for the IP rotation service.
IP_ROTATION_ENABLED=true

# How often each proxy is checked for rotation eligibility, in milliseconds.
# Default: 120000 (2 minutes)
IP_ROTATION_CHECK_INTERVAL_MS=120000

# How long to wait after triggering a rotation before resuming tests, in milliseconds.
# Default: 5000 (5s)
IP_ROTATION_WAIT_AFTER_ROTATION_MS=5000

# Minimum time between two rotations on the same proxy, in milliseconds.
# Prevents rotation storms. Default: 300000 (5 minutes)
IP_ROTATION_COOLDOWN_MS=300000

# When true, the rotation service prefers IPs not recently seen on this proxy.
IP_ROTATION_PREFER_UNIQUE=false

# How often a periodic forced rotation is triggered, in milliseconds.
# Default: 600000 (10 minutes)
PERIODIC_IP_ROTATION_INTERVAL_MS=600000


# =============================================================================
# IP ROTATION TESTING (Stress / QA)
# =============================================================================

# Master switch for the IP rotation stress-test service.
IP_ROTATION_TESTING_ENABLED=true

# How often rotation stress tests run, in milliseconds.
# Default: 900000 (15 minutes)
IP_ROTATION_TESTING_INTERVAL_MS=900000

# Wait time after each rotation during stress testing, in milliseconds.
# Default: 10000 (10s)
IP_ROTATION_TESTING_WAIT_AFTER_ROTATION_MS=10000

# Number of proxies tested simultaneously during a stress test run.
IP_ROTATION_TESTING_CONCURRENCY=10

# Number of proxies included in each stress test batch.
IP_ROTATION_TESTING_BATCH_SIZE=50


# =============================================================================
# SPEED TESTS
# =============================================================================

# How often download/upload speed is measured per proxy, in milliseconds.
# Default: 360000 (6 minutes)
SPEED_TEST_INTERVAL_MS=360000


# =============================================================================
# RUNTIME
# =============================================================================

# Minimum number of hours the process must run before a clean shutdown is allowed.
MIN_RUN_HOURS=72

# Run mode. Use "infinite" for production continuous operation.
RUN_MODE="infinite"

# How often the runtime monitor checks system health, in milliseconds.
# Default: 3600000 (1 hour)
MONITOR_CHECK_INTERVAL_MS=3600000


# =============================================================================
# LOGGING
# =============================================================================

# Log verbosity level. Options: trace | debug | info | warn | error | fatal
LOG_LEVEL="info"

# Set to true to also print logs to stdout (useful for Docker / local dev).
LOG_TO_CONSOLE=false

# Directory where log files are written.
LOGS_DIR=./logs


# =============================================================================
# HEALTH CHECK SERVER
# =============================================================================

# Port the HTTP health check endpoint listens on.
# GET /health returns 200 when the service is running.
HEALTH_CHECK_PORT=3000


# =============================================================================
# DATA ARCHIVAL & RETENTION
# =============================================================================

# Master switch for the archival service.
# When enabled, raw proxy_requests older than DATA_RETENTION_DAYS are deleted
# after being aggregated into proxy_requests_daily_summary.
ENABLE_ARCHIVAL=true

# Number of days to keep raw proxy_requests data.
# After this period, rows are aggregated into the daily summary and deleted.
# Note: with MySQL partitioning enabled, old partitions are dropped automatically
# by the manage_proxy_requests_partitions EVENT — this setting controls the
# application-level archival service fallback.
# Default: 30
DATA_RETENTION_DAYS=30

# How often the archival service runs, in milliseconds.
# Default: 43200000 (12 hours)
ARCHIVAL_INTERVAL_MS=43200000

# Whether archival should run immediately on app startup.
# Set false when load-testing ingestion to avoid startup aggregation/delete pressure.
ARCHIVAL_RUN_ON_START=true

# Maximum rows deleted per archival batch to avoid long-running transactions.
# Default: 1000
ARCHIVAL_BATCH_SIZE=1000


# =============================================================================
# DAILY AGGREGATION
# =============================================================================

# Cron schedule for the daily aggregation job (MINUTE HOUR * * *).
# The job aggregates the previous day's proxy_requests into proxy_requests_daily_summary.
# Only MINUTE and HOUR fields are used — this is always a daily job.
#
# Default:  0 1 * * *  =  01:00 AM
# Examples: 0 2 * * *  =  02:00 AM
#           30 3 * * *  =  03:30 AM
#
# Run this job before the archival service (ARCHIVAL_INTERVAL_MS) to ensure
# data is summarised before raw rows are deleted.
AGGREGATION_SCHEDULE="0 1 * * *"

# Enable/disable starting daily aggregation service at app startup.
# Set to false while load-testing ingestion path without aggregation pressure.
ENABLE_DAILY_AGGREGATION_ON_START=true


# =============================================================================
# ALERT MONITORING
# =============================================================================

# Master switch for the alert monitoring service.
ENABLE_ALERT_MONITORING=true

# How often the alert monitor checks for threshold breaches, in milliseconds.
# Default: 120000 (2 minutes)
ALERT_CHECK_INTERVAL_MS=120000

# Generic webhook URL for alert notifications (optional).
ALERT_WEBHOOK_URL=""

# Slack incoming webhook URL for alert notifications (optional).
SLACK_WEBHOOK_URL=""


# =============================================================================
# GRAFANA
# =============================================================================

# Admin credentials for the Grafana instance (used in docker-compose).
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=admin


# =============================================================================
# DATABASE EXPORT (optional)
# =============================================================================

# Uncomment to enable scheduled database exports.
# EXPORT_FORMAT="sql"
# EXPORT_OUTPUT_DIR="./exports"
# EXPORT_TABLES="proxies,proxy_requests"
