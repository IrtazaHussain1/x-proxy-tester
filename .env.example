# =============================================================================
# ENVIRONMENT CONFIGURATION EXAMPLE
# =============================================================================
# Copy this file to .env and fill in real values.
# Never commit .env to version control.
# =============================================================================


# =============================================================================
# DATABASE
# =============================================================================

# Primary MySQL connection string.
# Format: mysql://USER:PASSWORD@HOST:PORT/DATABASE
DATABASE_URL="mysql://xproxy:xproxy@localhost:3310/xproxy_tester?connection_limit=100&pool_timeout=30"

# 64-character hex encryption key for sensitive fields at rest (proxy passwords).
# Generate: node -e "require('crypto').randomBytes(32).toString('hex')"
# REQUIRED in production — app throws on startup if unset or left as the default.
ENCRYPTION_KEY=

# Optional extra salt used during key derivation. Leave blank to use the built-in default.
ENCRYPTION_SALT=


# =============================================================================
# XPROXY PORTAL API
# =============================================================================

# Base URL of the XProxy API.
XPROXY_API_URL="https://proxyapi.jumpermedia.co/v2"

# Endpoint path for fetching the device list.
XPROXY_API_ENDPOINT="api/devices"

# Timeout in milliseconds for XProxy API calls. Default: 30000 (30s)
XPROXY_API_TIMEOUT_MS=30000

# Credentials used for automated auth-token refresh.
XPROXY_LOGIN_URL="https://proxyapi.jumpermedia.co/v2/auth/login"
XPROXY_LOGIN_EMAIL=
XPROXY_LOGIN_PASSWORD=


# =============================================================================
# PROXY TESTING
# =============================================================================

# URL used to verify the proxy and detect the outbound IP.
TEST_TARGET_URL="https://api.ipify.org?format=json"

# How often each proxy is tested (ms). Recommended: 5000–30000.
TEST_INTERVAL_MS=30000

# Maximum time to wait for a single proxy test request (ms).
REQUEST_TIMEOUT_MS=30000

# Consecutive same-IP count before a rotation is triggered.
ROTATION_THRESHOLD=10

# How often the proxy list is refreshed from the XProxy API (ms). Default: 900000 (15 min)
PROXY_REFRESH_INTERVAL_MS=900000

# Test proxies that are currently inactive in the portal. Default: false
TEST_INACTIVE_PROXIES=false


# =============================================================================
# STABILITY CALCULATION
# =============================================================================

# How often stability scores are recalculated (ms). Default: 600000 (10 min)
STABILITY_CHECK_INTERVAL_MS=600000


# =============================================================================
# AUTO-DEACTIVATION
# =============================================================================

# Enable automatic deactivation of consistently failing proxies.
AUTO_DEACTIVATION_ENABLED=true

# Consecutive failures before deactivation is considered.
AUTO_DEACTIVATION_CONSECUTIVE_FAILURES=20

# Failure rate threshold (0–1) over the last N requests.
AUTO_DEACTIVATION_FAILURE_RATE=0.9

# Window size (number of recent requests) for failure rate calculation.
AUTO_DEACTIVATION_FAILURE_RATE_WINDOW=50


# =============================================================================
# AUTO-RECOVERY
# =============================================================================

# Enable automatic re-activation of deactivated proxies that recover.
AUTO_RECOVERY_ENABLED=true

# How often recovery checks run (ms). Default: 600000 (10 min)
AUTO_RECOVERY_CHECK_INTERVAL_MS=600000

# Consecutive successes required to re-activate a proxy.
AUTO_RECOVERY_CONSECUTIVE_SUCCESSES=5


# =============================================================================
# IP ROTATION
# =============================================================================

# Master switch for the IP rotation service.
IP_ROTATION_ENABLED=true

# How often a periodic forced rotation is triggered (ms). Default: 600000 (10 min)
PERIODIC_IP_ROTATION_INTERVAL_MS=600000

# Wait time after a rotation before testing the new IP (ms). Default: 5000
IP_ROTATION_WAIT_AFTER_ROTATION_MS=5000

# Cooldown between rotation attempts for the same proxy (ms). Default: 300000 (5 min)
IP_ROTATION_COOLDOWN_MS=300000

# Prefer unique (non-previously-seen) IPs when rotating. Default: false
IP_ROTATION_PREFER_UNIQUE=false


# =============================================================================
# RUNTIME
# =============================================================================

# Minimum hours the process must run before a clean shutdown is allowed (fixed mode).
MIN_RUN_HOURS=72

# Run mode: "infinite" (runs until SIGTERM) or "fixed" (stops after MIN_RUN_HOURS).
RUN_MODE="infinite"

# How often the runtime monitor checks elapsed time (ms). Default: 3600000 (1h)
MONITOR_CHECK_INTERVAL_MS=3600000


# =============================================================================
# LOGGING
# =============================================================================

# Log verbosity. Options: trace | debug | info | warn | error | fatal
LOG_LEVEL="info"

# Write logs to console in addition to file. Default: false (file only in production)
LOG_TO_CONSOLE=false

# Directory for log files (inside container).
LOGS_DIR=/app/logs


# =============================================================================
# HEALTH CHECK & MANAGEMENT API
# =============================================================================

# Port the HTTP server listens on. GET /health, GET /metrics, POST /api/testing/*
HEALTH_CHECK_PORT=3000

# Bearer token required for mutation endpoints (POST /api/testing/start|stop).
# Leave blank to disable auth (open — fine for local dev, insecure in production).
# Generate: node -e "require('crypto').randomBytes(32).toString('hex')"
API_SECRET_KEY=

# Allowed CORS origin for browser clients. Defaults to '*' (all origins).
# Set to your dashboard domain in production, e.g. https://dashboard.example.com
CORS_ALLOWED_ORIGIN=*


# =============================================================================
# REDIS / BULLMQ WRITE QUEUE
# =============================================================================

REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_DB=0

# Password for Redis auth. Leave blank for no auth (local dev only).
# Set a strong value in production — BullMQ job payloads contain device credentials.
REDIS_PASSWORD=

# Platform override for the Redis Docker image (arm64 for Apple Silicon, amd64 for x86).
REDIS_DOCKER_PLATFORM=linux/arm64/v8

# Number of parallel BullMQ workers for proxy test writes.
PROXY_TEST_WRITE_WORKER_CONCURRENCY=5

# Number of parallel BullMQ workers for proxy metadata writes (keep at 1).
PROXY_META_WRITE_WORKER_CONCURRENCY=1

# Remove completed jobs from Redis immediately to keep memory low. Default: true
BULLMQ_PURGE_COMPLETED_JOBS=true

# Number of failed jobs to retain in Redis for inspection. Default: 2000
BULLMQ_KEEP_FAILED_JOBS=2000


# =============================================================================
# DAILY AGGREGATION
# =============================================================================

# UTC schedule for the daily aggregation job (MINUTE HOUR format, runs daily).
# Examples: "0 1" = 01:00 UTC | "30 2" = 02:30 UTC
# Must run before the archival window closes for that day.
AGGREGATION_SCHEDULE="0 1"

# Days to re-aggregate on every app restart (catches any days skipped under DB pressure).
# Default: 2. Set to 0 to disable startup backfill.
STARTUP_DAILY_BACKFILL_DAYS=2

# Run the aggregation service when the app starts. Default: true
ENABLE_DAILY_AGGREGATION_ON_START=true

# Delay between per-proxy aggregation pages (ms). Yields DB connections to write workers.
AGGREGATION_PROXY_DELAY_MS=100

# Watchdog timeout for a single aggregation run (ms). Releases the lock if a DB query
# hangs without throwing. Default: 14400000 (4h). Useful to lower in testing.
AGGREGATION_WATCHDOG_MS=14400000


# =============================================================================
# DATA ARCHIVAL & RETENTION
# =============================================================================

# Enable archival: raw proxy_requests older than DATA_RETENTION_DAYS are deleted
# after being summarised into proxy_requests_daily_summary.
ENABLE_ARCHIVAL=false

# Days to keep raw proxy_requests before deletion. Default: 30
DATA_RETENTION_DAYS=30

# How often the archival service runs (ms). Default: 43200000 (12h)
ARCHIVAL_INTERVAL_MS=43200000

# Max rows deleted per archival batch (keeps transactions short). Default: 1000
ARCHIVAL_BATCH_SIZE=1000

# Run archival immediately on startup. Default: false
ARCHIVAL_RUN_ON_START=false


# =============================================================================
# SPEED TEST
# =============================================================================

# Enable periodic download/upload speed tests through each proxy.
SPEED_TEST_ENABLED=true

# How often speed tests run per proxy (ms). Default: 300000 (5 min)
SPEED_TEST_INTERVAL_MS=300000

# Max simultaneous speed test connections. Default: 25
SPEED_TEST_MAX_CONCURRENT=25


# =============================================================================
# DUPLICATE IP SNAPSHOT
# =============================================================================

# Take periodic snapshots of proxies sharing the same outbound IP.
DUPLICATE_IP_SNAPSHOT_ENABLED=false

# How often snapshots are taken (ms). Default: 300000 (5 min)
DUPLICATE_IP_SNAPSHOT_INTERVAL_MS=300000

# Days to retain snapshot data. Default: 90
DUPLICATE_IP_SNAPSHOT_RETENTION_DAYS=90


# =============================================================================
# ALERT MONITORING
# =============================================================================

# Enable threshold-based alerts.
ENABLE_ALERT_MONITORING=true

# How often the alert monitor checks for breaches (ms). Default: 120000 (2 min)
ALERT_CHECK_INTERVAL_MS=120000

# Webhook URLs for alert delivery. Leave blank to disable.
ALERT_WEBHOOK_URL=
SLACK_WEBHOOK_URL=


# =============================================================================
# GRAFANA
# =============================================================================

GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=admin


# =============================================================================
# DATABASE CONNECTION POOLS
# =============================================================================

# Connections reserved for write workers (INSERT-heavy path). Default: 20
DB_WRITE_CONNECTION_LIMIT=20

# Connections reserved for background jobs (aggregation, archival). Default: 8
DB_BACKGROUND_CONNECTION_LIMIT=8

# Connections for API reads and health checks. Default: 15
DB_CONNECTION_LIMIT=15

# Max concurrent portal→DB proxy row syncs per refresh cycle. Default: 20
PROXY_SYNC_CONCURRENCY=20
