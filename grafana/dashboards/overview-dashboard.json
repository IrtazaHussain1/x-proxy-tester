      "targets": [
        {
          "datasource": { "type": "mysql", "uid": "xproxy-tester-mysql" },
          "format": "table",
          "rawSql": "SELECT p.name, p.location, COALESCE(p.version, '-') as version, COUNT(*) as total_requests, COUNT(CASE WHEN r.status = 'SUCCESS' THEN 1 END) as success_count, ROUND(COUNT(CASE WHEN r.status = 'SUCCESS' THEN 1 END) * 100.0 / NULLIF(COUNT(*), 0), 2) as success_rate_pct, COUNT(CASE WHEN r.status != 'SUCCESS' THEN 1 END) as failure_count, ROUND(COUNT(CASE WHEN r.status != 'SUCCESS' THEN 1 END) * 100.0 / NULLIF(COUNT(*), 0), 2) as failure_rate_pct, ROUND(AVG(r.response_time_ms), 0) as avg_response_ms, p.stability_status, p.rotation_status FROM proxy_requests r JOIN proxies p ON r.proxy_id = p.device_id WHERE $__timeFilter(r.timestamp) AND p.location IN ($location) AND p.active = true GROUP BY p.device_id, p.name, p.location, p.version, p.stability_status, p.rotation_status ORDER BY success_rate_pct ASC, total_requests DESC"
        }
      ],
      "title": "All Proxies – Success Rate & Overview",
      "type": "table"
