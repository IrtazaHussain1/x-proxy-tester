{
  "uid": "rotation-dashboard-filtered",
  "title": "XProxy Tester - IP Rotation Analysis_Filtered",
  "timezone": "browser",
  "schemaVersion": 38,
  "version": 1,
  "refresh": "1m",
  "panels": [
    {
      "id": 1,
      "type": "stat",
      "title": "Proxies Rotated",
      "gridPos": { "h": 4, "w": 6, "x": 0, "y": 0 },
      "targets": [
        {
          "datasource": { "type": "mysql", "uid": "xproxy-tester-mysql" },
          "rawSql": "SELECT COUNT(*) as value FROM proxies WHERE active = true AND rotation_status = 'Rotated' AND location IN ($location)",
          "format": "table"
        }
      ]
    },
    {
      "id": 2,
      "type": "stat",
      "title": "Rotations (24h)",
      "gridPos": { "h": 4, "w": 6, "x": 6, "y": 0 },
      "targets": [
        {
          "datasource": { "type": "mysql", "uid": "xproxy-tester-mysql" },
          "rawSql": "SELECT IFNULL(SUM(rotation_count), 0) as value FROM proxies WHERE active = true AND last_rotation_at >= DATE_SUB(NOW(), INTERVAL 24 HOUR) AND location IN ($location)",
          "format": "table"
        }
      ]
    }
  ],
  "templating": {
    "list": [
      {
        "name": "location",
        "type": "query",
        "datasource": { "type": "mysql", "uid": "xproxy-tester-mysql" },
        "query": "SELECT DISTINCT location FROM proxies WHERE location IS NOT NULL",
        "refresh": 1,
        "multi": true,
        "includeAll": true
      }
    ]
  }
}
