            "type": "mysql",
            "uid": "xproxy-tester-mysql"
          },
          "format": "table",
          "rawSql": "SELECT COUNT(DISTINCT r.outbound_ip) as value FROM proxy_requests r JOIN proxies p ON r.proxy_id = p.device_id WHERE $__timeFilter(r.timestamp) AND r.outbound_ip IS NOT NULL AND p.location IN ($location)",
          "refId": "A"
