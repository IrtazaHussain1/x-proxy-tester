          },
          "format": "table",
          "rawSql": "WITH filtered_proxies AS (\n  SELECT p.device_id, p.name FROM proxies p WHERE p.location IN ($location)\n),\nphone_stats AS (\n  SELECT\n    s.proxy_id,\n    CONCAT(fp.name, ' [', s.proxy_id, ']')                                            AS phone,\n    SUM(s.total_requests)                                                               AS total_requests,\n    ROUND(SUM(s.success_count) * 100.0 / NULLIF(SUM(s.total_requests), 0), 2)         AS uptime_pct,\n    ROUND(\n      SUM(s.avg_response_time_ms * s.total_requests) / NULLIF(SUM(s.total_requests), 0),\n    0)                                                                                  AS avg_response_ms,\n    SUM(s.ip_change_count)                                                              AS ip_rotations,\n    GREATEST(1, TIMESTAMPDIFF(HOUR, MIN(s.window_start), MAX(s.window_start)) + 1)    AS active_hours_estimated\n  FROM proxy_requests_5min_summary s\n  JOIN filtered_proxies fp ON fp.device_id = s.proxy_id\n  WHERE $__timeFilter(s.window_start)\n  GROUP BY s.proxy_id, fp.name\n)\nSELECT\n  phone,\n  total_requests,\n  uptime_pct,\n  avg_response_ms,\n  ip_rotations,\n  ROUND(ip_rotations / NULLIF(active_hours_estimated, 0), 2)                          AS rotations_per_active_hour,\n  ROUND(\n    (100 - uptime_pct) * 0.6\n    + LEAST(avg_response_ms / 100.0, 40) * 0.3\n    + GREATEST(0, 5 - (ip_rotations / NULLIF(active_hours_estimated, 1))) * 2.0,\n  2)                                                                                    AS unstable_score\nFROM phone_stats\nWHERE total_requests >= 20\nORDER BY unstable_score DESC\nLIMIT 25",
          "refId": "A"
        }
      ],
      "title": "Top Unstable Phones Leaderboard",
      "type": "table"
    }
  ],
