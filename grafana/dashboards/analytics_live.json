        {
          "datasource": {
            "type": "mysql",
            "uid": "xproxy-tester-mysql"
          },
          "format": "time_series",
          "rawSql": "SELECT s.window_start AS time, 'TIMEOUT' AS metric, SUM(s.timeout_count) AS value\nFROM proxy_requests_5min_summary s\nJOIN proxies p ON s.proxy_id = p.device_id\nWHERE $__timeFilter(s.window_start) AND p.location IN ($location)\nGROUP BY s.window_start\nUNION ALL\nSELECT s.window_start, 'CONNECTION_ERROR', SUM(s.connection_error_count)\nFROM proxy_requests_5min_summary s\nJOIN proxies p ON s.proxy_id = p.device_id\nWHERE $__timeFilter(s.window_start) AND p.location IN ($location)\nGROUP BY s.window_start\nUNION ALL\nSELECT s.window_start, 'HTTP_ERROR', SUM(s.http_error_count)\nFROM proxy_requests_5min_summary s\nJOIN proxies p ON s.proxy_id = p.device_id\nWHERE $__timeFilter(s.window_start) AND p.location IN ($location)\nGROUP BY s.window_start\nUNION ALL\nSELECT s.window_start, 'DNS_ERROR', SUM(s.dns_error_count)\nFROM proxy_requests_5min_summary s\nJOIN proxies p ON s.proxy_id = p.device_id\nWHERE $__timeFilter(s.window_start) AND p.location IN ($location)\nGROUP BY s.window_start\nORDER BY 1",
          "refId": "A"
        }
      ],
      "title": "Failure Reason Breakdown \u2014 Trend",
      "type": "timeseries"
