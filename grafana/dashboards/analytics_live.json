                "value": [
                  {
                    "targetBlank": true,
                    "title": "Drilldown: Deep Dive (Location)",
                    "url": "/d/proxy-analytics-deep-dive-beta?var-location=${__value.text}&from=${__from}&to=${__to}"
                  }
                ]
