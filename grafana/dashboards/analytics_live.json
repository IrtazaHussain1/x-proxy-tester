                  {
                    "targetBlank": true,
                    "title": "Drilldown: Deep Dive (Server)",
                    "url": "/d/proxy-analytics-deep-dive-beta?${location:queryparam}&var-server=${__value.text}&from=${__from}&to=${__to}"
                  }
                ]
              }
            ]
