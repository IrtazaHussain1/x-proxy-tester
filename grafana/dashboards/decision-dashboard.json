      "targets": [
        {
          "datasource": {
            "type": "mysql",
            "uid": "xproxy-tester-mysql"
          },
          "format": "table",
          "rawSql": "SELECT COUNT(*) AS value\nFROM (\n  SELECT\n    s.proxy_id,\n    SUM(s.failure_count) * 100.0 / NULLIF(SUM(s.total_requests), 0) AS error_rate\n  FROM proxy_requests_5min_summary s\n  JOIN proxies p ON s.proxy_id = p.device_id\n  WHERE $__timeFilter(s.window_start)\n    AND p.location IN ($location)\n    AND p.city IN ($city)\n    AND p.active IN ($active)\n  GROUP BY s.proxy_id\n) per_proxy\nWHERE per_proxy.error_rate > (\n  SELECT AVG(error_rate) + 2 * STDDEV_SAMP(error_rate)\n  FROM (\n    SELECT\n      s.proxy_id,\n      SUM(s.failure_count) * 100.0 / NULLIF(SUM(s.total_requests), 0) AS error_rate\n    FROM proxy_requests_5min_summary s\n    JOIN proxies p ON s.proxy_id = p.device_id\n    WHERE $__timeFilter(s.window_start)\n      AND p.location IN ($location)\n      AND p.city IN ($city)\n      AND p.active IN ($active)\n    GROUP BY s.proxy_id\n  ) stats\n)",
          "refId": "A"
        }
      ],
      "title": "Proxies Above Normal Error Rate",
      "type": "stat"
    },
