          "rawSql": "SELECT\n  UNIX_TIMESTAMP(DATE_FORMAT(rc.cycle_timestamp, '%Y-%m-%d %H:%i:00')) as time_sec,\n  COUNT(CASE \n    WHEN ir.ip_before IS NOT NULL \n      AND ir.ip_after IS NOT NULL \n      AND ir.ip_before != ir.ip_after \n    THEN 1 \n  END) * 100.0 / NULLIF(COUNT(ir.id), 0) as ip_change_rate\nFROM rotation_cycles rc\nJOIN ip_rotations ir ON rc.id = ir.cycle_id\nJOIN proxies p ON ir.proxy_id = p.device_id\nWHERE rc.cycle_type = 'periodic'\n  AND $__timeFilter(rc.cycle_timestamp)\n  AND p.location IN ($location)\n  AND p.city IN ($city)\nGROUP BY time_sec\nORDER BY time_sec",
          "refId": "A"
        }
      ],
