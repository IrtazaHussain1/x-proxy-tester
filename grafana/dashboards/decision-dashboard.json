          "rawSql": "SELECT\n  p.device_id,\n  p.name,\n  p.location,\n  p.city,\n  p.version,\n  SUM(s.total_requests)                                                                        AS total_requests,\n  SUM(s.failure_count)                                                                         AS error_count,\n  ROUND(SUM(s.failure_count) * 100.0 / NULLIF(SUM(s.total_requests), 0), 2)                  AS error_rate,\n  ROUND(SUM(s.avg_response_time_ms * s.total_requests) / NULLIF(SUM(s.total_requests), 0), 0) AS avg_response_time_ms,\n  DATE_ADD(MAX(s.window_start), INTERVAL 5 MINUTE)                                            AS last_seen\nFROM proxy_requests_5min_summary s\nJOIN proxies p ON s.proxy_id = p.device_id\nWHERE $__timeFilter(s.window_start)\n  AND p.location IN ($location)\n  AND p.city IN ($city)\n  AND p.active IN ($active)\nGROUP BY p.device_id, p.name, p.location, p.city, p.version\nORDER BY error_rate DESC, avg_response_time_ms DESC\nLIMIT $limit",
