          "rawSql": "SELECT 'Total Proxies' as metric, COUNT(*) as value FROM proxies WHERE active IN ($active) AND location IN ($location) AND city IN ($city)\nUNION ALL\nSELECT 'Active Proxies' as metric, COUNT(*) as value FROM proxies WHERE active = true AND active IN ($active) AND location IN ($location) AND city IN ($city)\nUNION ALL\nSELECT 'Inactive Proxies' as metric, COUNT(*) as value FROM proxies WHERE active = false AND active IN ($active) AND location IN ($location) AND city IN ($city)",
