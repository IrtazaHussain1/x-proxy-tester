        {
          "datasource": {
            "type": "mysql",
            "uid": "xproxy-tester-mysql"
          },
          "format": "table",
          "rawSql": "SELECT COUNT(*) as value\nFROM (\n  SELECT\n    p.device_id,\n    SUM(CASE WHEN pr.status != 'SUCCESS' THEN 1 ELSE 0 END) * 100.0 / COUNT(*) as error_rate\n  FROM proxies p\n  JOIN proxy_requests pr ON p.device_id = pr.proxy_id\n  WHERE $__timeFilter(pr.timestamp)\n    AND p.location IN ($location)\n    AND p.city IN ($city)\n  GROUP BY p.device_id\n) per_proxy\nWHERE per_proxy.error_rate > (\n  SELECT AVG(error_rate) + 2 * STDDEV_SAMP(error_rate)\n  FROM (\n    SELECT\n      p.device_id,\n      SUM(CASE WHEN pr.status != 'SUCCESS' THEN 1 ELSE 0 END) * 100.0 / COUNT(*) as error_rate\n    FROM proxies p\n    JOIN proxy_requests pr ON p.device_id = pr.proxy_id\n    WHERE $__timeFilter(pr.timestamp)\n      AND p.location IN ($location)\n      AND p.city IN ($city)\n    GROUP BY p.device_id\n  ) stats\n)",
          "refId": "A"
        }
      ],
      "title": "Proxies Above Normal Error Rate",
      "type": "stat"
    },
