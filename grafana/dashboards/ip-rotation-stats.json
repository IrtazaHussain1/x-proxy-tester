      "targets": [
        {
          "dataset": "xproxy_tester",
          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT \n    p.device_id as proxy_id,\n    p.name as proxy_name,\n    p.proxy_status,\n    p.country,\n    p.city,\n    COUNT(ir.id) as total_rotation_attempts,\n    SUM(CASE WHEN ir.success = 1 THEN 1 ELSE 0 END) as successful_rotations,\n    SUM(CASE WHEN ir.success = 0 THEN 1 ELSE 0 END) as failed_rotations,\n    MAX(ir.rotation_timestamp) as last_rotation_attempt,\n    MAX(ir.error_message) as last_error\nFROM \n    proxies p\nLEFT JOIN \n    ip_rotations ir ON p.device_id = ir.proxy_id\nWHERE \n    ir.id IS NOT NULL  -- Has rotation attempts\n    AND NOT EXISTS (\n        SELECT 1 \n        FROM ip_rotations ir2 \n        WHERE ir2.proxy_id = p.device_id \n        AND ir2.success = 1\n    )  -- But no successful rotations\n    AND $__timeFilter(ir.rotation_timestamp)\nGROUP BY \n    p.device_id, p.name, p.proxy_status, p.country, p.city\nORDER BY \n    total_rotation_attempts DESC;",
          "refId": "A",
          "sql": {
            "columns": [
              {
                "parameters": [],
                "type": "function"
              }
            ],
            "groupBy": [
              {
                "property": {
                  "type": "string"
                },
                "type": "groupBy"
              }
            ],
            "limit": 50
          }
        }
      ],
      "title": "Never Rotated Proxies",
