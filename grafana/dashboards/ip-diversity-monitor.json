      "targets": [
        {
          "datasource": {
            "type": "mysql",
            "uid": "xproxy-tester-mysql"
          },
          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT\n  s.server_label,\n  COUNT(DISTINCT s.last_ip) AS duplicate_ips,\n  SUM(r.phones_on_same_ip) AS affected_phones,\n  MAX(r.phones_on_same_ip) AS max_on_one_ip\nFROM duplicate_ip_snapshot_servers s\nINNER JOIN duplicate_ip_snapshot_rows r\n  ON r.captured_at = s.captured_at\n  AND r.proxy_status_scope = s.proxy_status_scope\n  AND r.last_ip = s.last_ip\nWHERE s.proxy_status_scope = 'all'\n  AND s.captured_at = (\n    SELECT MAX(captured_at)\n    FROM duplicate_ip_snapshot_servers\n    WHERE proxy_status_scope = 'all'\n  )\nGROUP BY s.server_label\nORDER BY affected_phones DESC\nLIMIT 20",
          "refId": "A"
        }
      ],
