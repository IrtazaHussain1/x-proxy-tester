          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT\n  last_ip,\n  COUNT(DISTINCT device_id) AS phones_on_ip,\n  GROUP_CONCAT(DISTINCT name ORDER BY name SEPARATOR ' | ') AS phone_names\nFROM proxies\nWHERE last_ip IS NOT NULL AND last_ip != ''\n  AND ('${proxy_status}' = 'all' OR proxy_status = '${proxy_status}')\nGROUP BY last_ip\nHAVING COUNT(DISTINCT device_id) > 1\nORDER BY phones_on_ip DESC\nLIMIT 15",
          "refId": "A"
        }
      ],
