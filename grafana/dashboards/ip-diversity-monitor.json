          },
          "editorMode": "code",
          "format": "time_series",
          "rawQuery": true,
          "rawSql": "SELECT time, unique_ip_sessions FROM (\n  SELECT\n    UNIX_TIMESTAMP(day) AS time,\n    CAST(COALESCE(SUM(unique_ips_count), 0) AS UNSIGNED) AS unique_ip_sessions\n  FROM proxy_requests_daily_summary\n  WHERE day >= DATE_SUB(CURDATE(), INTERVAL 30 DAY)\n    AND '$data_mode' = 'aggregate'\n  GROUP BY day\n  UNION ALL\n  SELECT\n    UNIX_TIMESTAMP(d) AS time,\n    CAST(COUNT(DISTINCT last_outbound_ip) AS UNSIGNED) AS unique_ip_sessions\n  FROM (\n    SELECT DATE(window_start) AS d, last_outbound_ip\n    FROM proxy_requests_5min_summary\n    WHERE window_start >= DATE_SUB(CURDATE(), INTERVAL 30 DAY)\n      AND last_outbound_ip IS NOT NULL\n      AND last_outbound_ip <> ''\n      AND '$data_mode' = 'raw'\n  ) AS raw_src\n  GROUP BY d\n) AS combined\nORDER BY time",
          "refId": "A"
        }
      ],
      "timeFrom": "30d",
      "title": "Unique IP Sessions per Day (30d)",
      "type": "timeseries"
    },
