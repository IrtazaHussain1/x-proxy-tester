          "editorMode": "code",
          "format": "time_series",
          "rawQuery": true,
          "rawSql": "SELECT\n  UNIX_TIMESTAMP(captured_at) AS time,\n  SUM(phones_on_same_ip) AS affected_phones,\n  COUNT(DISTINCT last_ip) AS duplicate_ips\nFROM duplicate_ip_snapshot_rows\nWHERE $__timeFilter(captured_at)\n  AND proxy_status_scope = 'all'\nGROUP BY captured_at\nORDER BY captured_at",
          "refId": "A"
        }
      ],
