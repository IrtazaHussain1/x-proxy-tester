      "targets": [
        {
          "datasource": {
            "type": "mysql",
            "uid": "xproxy-tester-mysql"
          },
          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT\n  p.name,\n  p.last_ip,\n  p.proxy_status,\n  CONCAT_WS(', ', NULLIF(TRIM(p.city),''), NULLIF(TRIM(p.state),'')) AS location,\n  d.phones_on_ip,\n  d.sibling_phones\nFROM proxies p\nINNER JOIN (\n  SELECT\n    last_ip,\n    COUNT(*) AS phones_on_ip,\n    GROUP_CONCAT(name ORDER BY name SEPARATOR ' | ') AS sibling_phones\n  FROM proxies\n  WHERE last_ip IS NOT NULL AND last_ip != ''\n    AND ('${proxy_status}' = 'all' OR proxy_status = '${proxy_status}')\n  GROUP BY last_ip\n  HAVING COUNT(*) > 1\n) d ON p.last_ip = d.last_ip\nWHERE ('${proxy_status}' = 'all' OR p.proxy_status = '${proxy_status}')\nORDER BY d.phones_on_ip DESC, p.last_ip, p.name\nLIMIT 200",
          "refId": "A"
        }
      ],
      "title": "Duplicate IP Detail \u2014 All Affected Phones (Now)",
      "type": "table"
