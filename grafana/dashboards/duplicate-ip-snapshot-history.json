          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT COALESCE(MAX(t.cnt), 0) AS value\nFROM (\n  SELECT x.captured_at,\n    SUM(CASE WHEN x.last_ip != '__snapshot_empty__' THEN 1 ELSE 0 END) AS cnt\n  FROM duplicate_ip_snapshot_rows x\n  WHERE x.proxy_status_scope = '${proxy_scope}'\n    AND $__timeFilter(x.captured_at)\n  GROUP BY x.captured_at\n) t",
          "refId": "A"
        }
      ],
