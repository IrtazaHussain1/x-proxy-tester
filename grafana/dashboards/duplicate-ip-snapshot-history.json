          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT\n  x.last_ip,\n  COUNT(DISTINCT x.captured_at) AS snapshot_appearances,\n  MAX(x.phones_on_same_ip) AS max_phones_sharing,\n  MIN(x.captured_at) AS first_seen,\n  MAX(x.captured_at) AS last_seen\nFROM duplicate_ip_snapshot_rows x\nWHERE x.proxy_status_scope = '${proxy_scope}'\n  AND $__timeFilter(x.captured_at)\n  AND x.last_ip != '__snapshot_empty__'\nGROUP BY x.last_ip\nORDER BY snapshot_appearances DESC, max_phones_sharing DESC\nLIMIT 100",
          "refId": "A"
        }
      ],
