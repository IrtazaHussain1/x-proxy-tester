          "rawSql": "SELECT COUNT(*) AS value\nFROM duplicate_ip_snapshot_rows x\nWHERE x.proxy_status_scope = '${proxy_scope}'\n  AND $__timeFilter(x.captured_at)\n  AND x.last_ip != '__snapshot_empty__'\n  AND x.captured_at = (\n    SELECT MAX(x2.captured_at)\n    FROM duplicate_ip_snapshot_rows x2\n    WHERE x2.proxy_status_scope = '${proxy_scope}'\n      AND $__timeFilter(x2.captured_at)\n  )",
