          "rawSql": "SELECT\n  row_tbl.last_ip,\n  row_tbl.location,\n  row_tbl.all_servers_on_ip,\n  row_tbl.phones_on_same_ip,\n  row_tbl.sibling_phones,\n  row_tbl.device_ids,\n  row_tbl.captured_at\nFROM duplicate_ip_snapshot_rows row_tbl\nWHERE row_tbl.proxy_status_scope = '${proxy_scope}'\n  AND $__timeFilter(row_tbl.captured_at)\n  AND row_tbl.last_ip != '__snapshot_empty__'\n  AND row_tbl.captured_at = (\n    SELECT MAX(x2.captured_at)\n    FROM duplicate_ip_snapshot_rows x2\n    WHERE x2.proxy_status_scope = '${proxy_scope}'\n      AND $__timeFilter(x2.captured_at)\n  )\nORDER BY row_tbl.phones_on_same_ip DESC, row_tbl.last_ip\nLIMIT 300",
