          "rawQuery": true,
          "rawSql": "SELECT\n  UNIX_TIMESTAMP(x.captured_at) AS time_sec,\n  SUM(CASE WHEN x.last_ip != '__snapshot_empty__' THEN 1 ELSE 0 END) AS duplicate_ip_rows\nFROM duplicate_ip_snapshot_rows x\nWHERE x.proxy_status_scope = '${proxy_scope}'\n  AND $__timeFilter(x.captured_at)\nGROUP BY x.captured_at\nORDER BY x.captured_at",
          "refId": "A"
