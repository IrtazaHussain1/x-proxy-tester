            "targets": [
                {
                    "dataset": "xproxy_tester",
                    "datasource": {
                        "type": "mysql",
                        "uid": "xproxy-tester-mysql"
                    },
                    "editorMode": "code",
                    "format": "table",
                    "rawQuery": true,
                    "rawSql": "WITH ProxyStats AS (\n    SELECT\n      proxy_id,\n      AVG(download_speed_mbps) AS avg_download,\n      MIN(download_speed_mbps) AS min_download,\n      MAX(download_speed_mbps) AS max_download,\n      AVG(upload_speed_mbps) AS avg_upload,\n      MIN(upload_speed_mbps) AS min_upload,\n      MAX(upload_speed_mbps) AS max_upload,\n      MAX(timestamp) AS last_test,\n      COUNT(*) AS test_count\n    FROM speed_tests\n    WHERE $__timeFilter(timestamp)\n    GROUP BY proxy_id\n),\n\nRequestStats AS (\n    SELECT\n      proxy_id,\n      COUNT(*) AS total_requests,\n      SUM(status = 'SUCCESS') AS success_count,\n      SUM(status != 'SUCCESS') AS error_count,\n      SUM(status = 'SUCCESS') * 100.0 / NULLIF(COUNT(*), 0) AS request_success_rate\n    FROM proxy_requests\n    WHERE $__timeFilter(timestamp)\n    GROUP BY proxy_id\n),\n\nRotationStats AS (\n    SELECT\n      proxy_id,\n      COUNT(DISTINCT cycle_id) AS rotation_cycles_count,\n      COUNT(*) AS total_rotation_attempts,\n      SUM(success = 1) AS successful_rotations,\n      SUM(success = 0) AS failed_rotations,\n      SUM(success = 1) * 100.0 / NULLIF(COUNT(*), 0) AS rotation_success_percentage,\n      MAX(rotation_timestamp) AS last_rotation_attempt\n    FROM ip_rotations\n    WHERE $__timeFilter(rotation_timestamp)\n    GROUP BY proxy_id\n)\n\nSELECT\n  p.name,\n  p.device_id,\n  p.location,\n  p.ws_status,\n  p.proxy_status,\n  p.version,\n  ps.last_test,\n  ps.avg_download,\n  NULL AS median_download,\n  ps.min_download,\n  ps.max_download,\n  ps.avg_upload,\n  NULL AS median_upload,\n  ps.min_upload,\n  ps.max_upload,\n  ps.test_count,\n  COALESCE(rs.total_requests, 0) AS total_requests,\n  COALESCE(rs.success_count, 0) AS success_count,\n  COALESCE(rs.error_count, 0) AS error_count,\n  COALESCE(rs.request_success_rate, 0) AS request_success_rate,\n  COALESCE(rot.rotation_cycles_count, 0) AS rotation_cycles_count,\n  COALESCE(rot.total_rotation_attempts, 0) AS total_rotation_attempts,\n  COALESCE(rot.successful_rotations, 0) AS successful_rotations,\n  COALESCE(rot.failed_rotations, 0) AS failed_rotations,\n  COALESCE(rot.rotation_success_percentage, 0) AS rotation_success_percentage,\n  rot.last_rotation_attempt\nFROM proxies p\nLEFT JOIN ProxyStats ps ON p.device_id = ps.proxy_id\nLEFT JOIN RequestStats rs ON p.device_id = rs.proxy_id\nLEFT JOIN RotationStats rot ON p.device_id = rot.proxy_id\nORDER BY rs.total_requests DESC;",
                    "refId": "A",
                    "sql": {
                        "columns": [
                            {
                                "parameters": [],
                                "type": "function"
                            }
                        ],
                        "groupBy": [
                            {
                                "property": {
                                    "type": "string"
                                },
                                "type": "groupBy"
                            }
                        ],
                        "limit": 50
                    }
                }
            ],
            "title": "Proxy Stats Aggregate",
            "type": "table"
