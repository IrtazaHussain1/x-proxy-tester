        "footer": { "countRows": false, "enablePagination": true, "reducer": ["sum"], "show": false },
        "showHeader": true,
        "sortBy": [{ "desc": true, "displayName": "Phones on Same IP" }]
      },
      "pluginVersion": "12.3.0",
      "targets": [
        {
          "datasource": { "type": "mysql", "uid": "xproxy-tester-mysql" },
          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT\n  p.device_id,\n  p.name,\n  p.last_ip,\n  p.model,\n  CONCAT_WS(', ',\n    NULLIF(TRIM(p.city), ''),\n    NULLIF(TRIM(p.state), ''),\n    NULLIF(TRIM(p.country), '')\n  ) AS location,\n  p.proxy_status,\n  dup.phones_on_same_ip,\n  dup.sibling_phones,\n  dup.sibling_device_ids\nFROM proxies p\nJOIN (\n  SELECT\n    last_ip,\n    COUNT(*) as phones_on_same_ip,\n    GROUP_CONCAT(name ORDER BY name SEPARATOR ' | ') as sibling_phones,\n    GROUP_CONCAT(device_id ORDER BY name SEPARATOR ' | ') as sibling_device_ids\n  FROM proxies\n  WHERE last_ip IS NOT NULL AND last_ip != ''\n  AND ('${proxy_status}' = 'all' OR proxy_status = '${proxy_status}')\n  GROUP BY last_ip\n  HAVING COUNT(*) > 1\n) dup ON p.last_ip = dup.last_ip\nWHERE ('${proxy_status}' = 'all' OR p.proxy_status = '${proxy_status}')\nORDER BY dup.phones_on_same_ip DESC, p.last_ip, p.name",
          "refId": "A"
        }
      ],
      "title": "All Affected Phones — Per-Device Detail",
      "type": "table"
    }

