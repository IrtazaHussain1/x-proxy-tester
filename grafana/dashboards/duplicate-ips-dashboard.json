          "rawQuery": true,
          "rawSql": "SELECT\n  last_ip,\n  COUNT(*) as phone_count,\n  SUM(CASE WHEN proxy_status = 'active' THEN 1 ELSE 0 END) as active_count,\n  SUM(CASE WHEN proxy_status = 'inactive' THEN 1 ELSE 0 END) as inactive_count,\n  GROUP_CONCAT(name ORDER BY name SEPARATOR ', ') as phones,\n  GROUP_CONCAT(device_id ORDER BY name SEPARATOR ', ') as device_ids,\n  GROUP_CONCAT(DISTINCT IFNULL(city,'?') ORDER BY city SEPARATOR ', ') as cities,\n  GROUP_CONCAT(DISTINCT IFNULL(country,'?') ORDER BY country SEPARATOR ', ') as countries\nFROM proxies\nWHERE last_ip IS NOT NULL AND last_ip != ''\nAND ('${proxy_status}' = 'all' OR proxy_status = '${proxy_status}')\nGROUP BY last_ip\nHAVING COUNT(*) > 1\nORDER BY phone_count DESC, last_ip",
