      "pluginVersion": "12.3.0",
      "targets": [
        {
          "datasource": { "type": "mysql", "uid": "xproxy-tester-mysql" },
          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT\n  CASE\n    WHEN is_unknown_location = 1 THEN 'No Location (N/A)'\n    WHEN city_label IS NULL AND state_label IS NULL THEN 'Unknown, '\n    ELSE CONCAT(IFNULL(city_label, 'Unknown'), ', ', IFNULL(state_label, ''))\n  END as location_label,\n  avg_lat,\n  avg_lon,\n  affected_phones,\n  duplicate_ips\nFROM (\n  SELECT\n    CASE\n      WHEN p.latitude IS NULL\n        OR p.longitude IS NULL\n        OR p.city IS NULL\n        OR p.city = ''\n        OR LOWER(p.city) = 'n/a'\n        OR p.state IS NULL\n        OR p.state = ''\n        OR LOWER(p.state) = 'n/a'\n      THEN 1\n      ELSE 0\n    END as is_unknown_location,\n    AVG(\n      CASE\n        WHEN p.latitude IS NULL\n          OR p.longitude IS NULL\n          OR p.city IS NULL\n          OR p.city = ''\n          OR LOWER(p.city) = 'n/a'\n          OR p.state IS NULL\n          OR p.state = ''\n          OR LOWER(p.state) = 'n/a'\n        THEN 32.5\n        ELSE p.latitude\n      END\n    ) as avg_lat,\n    AVG(\n      CASE\n        WHEN p.latitude IS NULL\n          OR p.longitude IS NULL\n          OR p.city IS NULL\n          OR p.city = ''\n          OR LOWER(p.city) = 'n/a'\n          OR p.state IS NULL\n          OR p.state = ''\n          OR LOWER(p.state) = 'n/a'\n        THEN -119.5\n        ELSE p.longitude\n      END\n    ) as avg_lon,\n    COUNT(*)                  as affected_phones,\n    COUNT(DISTINCT p.last_ip) as duplicate_ips,\n    SUBSTRING_INDEX(GROUP_CONCAT(p.city  ORDER BY p.city  SEPARATOR ','), ',', 1) as city_label,\n    SUBSTRING_INDEX(GROUP_CONCAT(p.state ORDER BY p.state SEPARATOR ','), ',', 1) as state_label\n  FROM proxies p\n  WHERE ('${proxy_status}' = 'all' OR p.proxy_status = '${proxy_status}')\n    AND p.last_ip IN (\n      SELECT last_ip\n      FROM proxies\n      WHERE last_ip IS NOT NULL AND last_ip != ''\n      AND ('${proxy_status}' = 'all' OR proxy_status = '${proxy_status}')\n      GROUP BY last_ip\n      HAVING COUNT(*) > 1\n    )\n  GROUP BY\n    CASE\n      WHEN p.latitude IS NULL\n        OR p.longitude IS NULL\n        OR p.city IS NULL\n        OR p.city = ''\n        OR LOWER(p.city) = 'n/a'\n        OR p.state IS NULL\n        OR p.state = ''\n        OR LOWER(p.state) = 'n/a'\n      THEN 'unknown'\n      ELSE CONCAT(ROUND(p.latitude, 1), ':', ROUND(p.longitude, 1))\n    END,\n    CASE\n      WHEN p.latitude IS NULL\n        OR p.longitude IS NULL\n        OR p.city IS NULL\n        OR p.city = ''\n        OR LOWER(p.city) = 'n/a'\n        OR p.state IS NULL\n        OR p.state = ''\n        OR LOWER(p.state) = 'n/a'\n      THEN 1\n      ELSE 0\n    END\n) t\nORDER BY affected_phones DESC",
          "refId": "A"
        }
      ],
      "title": "Geographic Distribution of Duplicate IP Phones",
      "type": "geomap"
    },

