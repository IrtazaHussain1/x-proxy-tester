          "rawQuery": true,
          "rawSql": "SELECT\n  CONCAT(IFNULL(city,'Unknown'), ', ', IFNULL(state,'')) as city_label,\n  COUNT(*) as affected_phones,\n  COUNT(DISTINCT last_ip) as duplicate_ips\nFROM proxies\nWHERE ('${proxy_status}' = 'all' OR proxy_status = '${proxy_status}')\nAND last_ip IN (\n  SELECT last_ip\n  FROM proxies\n  WHERE last_ip IS NOT NULL AND last_ip != ''\n  AND ('${proxy_status}' = 'all' OR proxy_status = '${proxy_status}')\n  GROUP BY last_ip\n  HAVING COUNT(*) > 1\n)\nGROUP BY city, state\nORDER BY affected_phones DESC\nLIMIT 20",
