          },
          "rawSql": "SELECT\n  upload_speed_mbps as value\nFROM (\n  SELECT\n    upload_speed_mbps,\n    ROW_NUMBER() OVER (ORDER BY upload_speed_mbps) as row_num,\n    COUNT(*) OVER () as total_count\n  FROM speed_tests\n  WHERE $__timeFilter(timestamp)\n    AND upload_speed_mbps IS NOT NULL\n) ranked\nWHERE row_num = FLOOR(total_count * 0.50) + 1\nLIMIT 1",
          "format": "table"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "mbps",
          "decimals": 2,
