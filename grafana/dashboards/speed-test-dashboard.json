    },
    {
      "id": 5,
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 4
      },
      "type": "timeseries",
      "title": "Download Speed History (Avg per Hour)",
      "targets": [
        {
          "datasource": {
            "type": "mysql",
            "uid": "xproxy-tester-mysql"
          },
          "rawSql": "SELECT\n  UNIX_TIMESTAMP(DATE_FORMAT(timestamp, '%Y-%m-%d %H:00:00')) as time_sec,\n  AVG(download_speed_mbps) as avg_download\nFROM speed_tests\nWHERE $__timeFilter(timestamp)\n  AND download_speed_mbps IS NOT NULL\nGROUP BY time_sec\nORDER BY time_sec",
          "format": "time_series",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "mbps",
          "color": {
            "mode": "palette-classic"
          }
        }
      }
    },
    {
      "id": 6,
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 4
      },
      "type": "timeseries",
      "title": "Upload Speed History (Avg per Hour)",
      "targets": [
        {
          "datasource": {
            "type": "mysql",
            "uid": "xproxy-tester-mysql"
          },
          "rawSql": "SELECT\n  UNIX_TIMESTAMP(DATE_FORMAT(timestamp, '%Y-%m-%d %H:00:00')) as time_sec,\n  AVG(upload_speed_mbps) as avg_upload\nFROM speed_tests\nWHERE $__timeFilter(timestamp)\n  AND upload_speed_mbps IS NOT NULL\nGROUP BY time_sec\nORDER BY time_sec",
          "format": "time_series",
          "refId": "B"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "mbps",
          "color": {
            "mode": "palette-classic"
          }
        }
      }
    },
    {
      "id": 7,
      "gridPos": {
        "h": 8,
        "w": 24,
        "x": 0,
        "y": 12
      },
      "type": "table",
      "title": "Top Proxies by Average Speed",
      "targets": [
        {
          "datasource": {
            "type": "mysql",
            "uid": "xproxy-tester-mysql"
          },
          "rawSql": "SELECT\n  p.name,\n  p.location,\n  AVG(pr.download_speed_mbps) as avg_download,\n  MIN(pr.download_speed_mbps) as min_download,\n  MAX(pr.download_speed_mbps) as max_download,\n  AVG(pr.upload_speed_mbps) as avg_upload,\n  MIN(pr.upload_speed_mbps) as min_upload,\n  MAX(pr.upload_speed_mbps) as max_upload,\n  COUNT(*) as test_count\nFROM proxies p\nJOIN speed_tests pr ON p.device_id = pr.proxy_id\nWHERE $__timeFilter(pr.timestamp)\n  AND (pr.download_speed_mbps IS NOT NULL OR pr.upload_speed_mbps IS NOT NULL)\nGROUP BY p.device_id, p.name, p.location\nORDER BY avg_download DESC\nLIMIT 100",
          "format": "table",
          "refId": "A"
        }
      ]
    }
  ],
  "time": {
