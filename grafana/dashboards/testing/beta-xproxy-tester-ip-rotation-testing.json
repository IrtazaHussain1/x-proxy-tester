        {
          "editorMode": "code",
          "format": "time_series",
          "rawQuery": true,
          "rawSql": "SELECT\n  $__timeGroup(rc.cycle_timestamp, '1d') AS time,\n\n  ROUND(AVG(\n    CASE\n      WHEN rc.total_proxies > 0\n      THEN (rc.successful_count * 100.0 / rc.total_proxies)\n      ELSE 0\n    END\n  ), 2) AS avg_success_rate_pct,\n\n  ROUND(MAX(\n    CASE\n      WHEN rc.total_proxies > 0\n      THEN (rc.successful_count * 100.0 / rc.total_proxies)\n      ELSE 0\n    END\n  ), 2) AS max_success_rate_pct,\n\n  ROUND(MIN(\n    CASE\n      WHEN rc.total_proxies > 0\n      THEN (rc.successful_count * 100.0 / rc.total_proxies)\n      ELSE 0\n    END\n  ), 2) AS min_success_rate_pct\n\nFROM rotation_cycles rc\nWHERE $__timeFilter(rc.cycle_timestamp)\n  AND rc.cycle_type = 'periodic'\n  AND rc.status != 'in_progress'\n\nGROUP BY time\nORDER BY time ASC;",
          "refId": "A",
          "sql": {
            "columns": [
