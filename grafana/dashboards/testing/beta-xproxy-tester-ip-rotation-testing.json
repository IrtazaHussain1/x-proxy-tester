        {
          "editorMode": "code",
          "format": "table",
          "hide": false,
          "rawQuery": true,
          "rawSql": "SELECT\n  DATE_FORMAT(rc.cycle_timestamp, '%Y-%m-%d %H:%i:%s') AS cycle_time,\n  rc.cycle_type,\n  rc.status,\n  rc.total_proxies,\n  rc.successful_count,\n  rc.failed_count,\n  rc.pending_count,\n  ROUND(\n    CASE\n      WHEN rc.total_proxies > 0 THEN (rc.successful_count * 100.0 / rc.total_proxies)\n      ELSE 0\n    END,\n    2\n  ) AS success_rate_pct\nFROM rotation_cycles rc\nWHERE $__timeFilter(rc.cycle_timestamp)\n  AND rc.cycle_type = 'periodic'\nGROUP BY\n  rc.id,\n  rc.cycle_timestamp,\n  rc.cycle_type,\n  rc.status,\n  rc.total_proxies,\n  rc.successful_count,\n  rc.failed_count,\n  rc.pending_count\nORDER BY rc.cycle_timestamp DESC\nLIMIT 200;",
