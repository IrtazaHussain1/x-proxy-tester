          "rawQuery": true,
          "rawSql": "SELECT\n  COUNT(DISTINCT rc.id) AS 'cycle',\n  COUNT(ir.id) AS 'rotation triggers',\n  COUNT(DISTINCT ir.proxy_id) AS 'unique proxies rotated'\nFROM rotation_cycles rc\nJOIN ip_rotations ir ON ir.cycle_id = rc.id\nJOIN proxies p ON p.device_id = ir.proxy_id\nWHERE rc.cycle_timestamp >= DATE_SUB(NOW(), INTERVAL 24 HOUR)\n  AND rc.cycle_type = 'periodic'\n  AND p.active = true\n  AND p.location IN ($location);",
          "refId": "A",
          "sql": {
            "columns": [
              {
                "parameters": [],
                "type": "function"
              }
            ],
