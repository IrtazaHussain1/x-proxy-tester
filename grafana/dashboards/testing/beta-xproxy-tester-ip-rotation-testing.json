      "targets": [
        {
          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "WITH RECURSIVE selected_days AS (\n  SELECT DATE($__timeFrom()) AS day\n  UNION ALL\n  SELECT DATE_ADD(day, INTERVAL 1 DAY)\n  FROM selected_days\n  WHERE day < LEAST(DATE($__timeTo()), DATE_SUB(CURDATE(), INTERVAL 1 DAY))\n),\nper_proxy_day_not_rotated AS (\n  SELECT\n    s.day,\n    s.proxy_id,\n    COALESCE(s.device_name, p.name, s.proxy_id) AS device_name\n  FROM proxy_requests_daily_summary s\n  JOIN proxies p ON p.device_id = s.proxy_id\n  WHERE s.day >= DATE($__timeFrom())\n    AND s.day <= LEAST(DATE($__timeTo()), DATE_SUB(CURDATE(), INTERVAL 1 DAY))\n    AND COALESCE(s.ip_change_count, 0) <= 0\n    AND p.location IN ($location)\n    AND p.active = true\n  GROUP BY s.day, s.proxy_id, COALESCE(s.device_name, p.name, s.proxy_id)\n)\nSELECT\n  DATE_FORMAT(d.day, '%Y-%m-%d') AS day,\n  COUNT(p.proxy_id) AS proxies_not_rotated_24h,\n  COALESCE(GROUP_CONCAT(p.proxy_id ORDER BY p.device_name SEPARATOR ' | '), 'No proxies') AS device_id_list,\n  COALESCE(GROUP_CONCAT(p.device_name ORDER BY p.device_name SEPARATOR ' | '), 'No proxies') AS device_name_list\nFROM selected_days d\nLEFT JOIN per_proxy_day_not_rotated p\n  ON p.day = d.day\nGROUP BY d.day\nORDER BY d.day;",
          "refId": "A",
          "sql": {
