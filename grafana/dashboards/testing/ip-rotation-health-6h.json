      "targets": [
        {
          "datasource": {
            "type": "mysql",
            "uid": "xproxy-tester-mysql"
          },
          "format": "table",
          "rawSql": "SELECT ANY_VALUE(s.server_name) AS server_name, s.proxy_id, ANY_VALUE(s.device_name) AS device_name, ANY_VALUE(s.location) AS location, s.cycle_type, ROUND(SUM(s.success_count) * 100.0 / NULLIF(SUM(s.attempts), 0), 2) AS success_pct, ROUND(SUM(s.same_ip_count) * 100.0 / NULLIF(SUM(s.attempts), 0), 2) AS wasted_pct, ROUND(SUM(s.pre_rotation_anomaly_count) * 100.0 / NULLIF(SUM(s.attempts), 0), 2) AS anomaly_pct, ipw.distinct_ips_window, ipw.duplicate_ip_pct, CASE WHEN ipw.distinct_ips_window <= 1 THEN 'Stuck' WHEN ipw.distinct_ips_window <= 5 THEN 'Cycling' WHEN ipw.distinct_ips_window <= 20 THEN 'Medium' ELSE 'Healthy' END AS rotation_pool_class, CASE WHEN ipw.distinct_ips_window <= 1 THEN 'Stuck — only 1 distinct IP seen across the entire window (rotation not changing the IP)' WHEN ipw.distinct_ips_window <= 5 THEN CONCAT('Cycling — small pool of ', ipw.distinct_ips_window, ' distinct IPs recycled over the window') WHEN ipw.distinct_ips_window <= 20 THEN CONCAT('Medium — ', ipw.distinct_ips_window, ' distinct IPs over the window') ELSE CONCAT('Healthy — ', ipw.distinct_ips_window, ' distinct IPs over the window') END AS pool_description, MAX(s.max_consecutive_same_ip) AS max_consecutive_same_ip, MAX(s.distinct_error_count) AS distinct_error_count, SUBSTRING_INDEX(GROUP_CONCAT(s.last_error ORDER BY s.bucket_start DESC SEPARATOR 0x1e), 0x1e, 1) AS last_error FROM ip_rotation_6h_summary s JOIN (SELECT proxy_id, cycle_type, COUNT(*) AS distinct_ips_window, ROUND(SUM(times_seen > 1) * 100.0 / NULLIF(COUNT(*), 0), 2) AS duplicate_ip_pct FROM (SELECT s2.proxy_id AS proxy_id, s2.cycle_type AS cycle_type, j.ip AS ip, SUM(j.cnt) AS times_seen FROM ip_rotation_6h_summary s2, JSON_TABLE(s2.ip_pool_snapshot, '$[*]' COLUMNS (ip VARCHAR(45) PATH '$.ip', cnt INT PATH '$.count')) j WHERE $__timeFilter(s2.bucket_start) AND s2.is_complete >= ${completeness} AND s2.server_name IN (${server:sqlstring}) AND s2.cycle_type IN (${cycle_type:sqlstring}) GROUP BY s2.proxy_id, s2.cycle_type, j.ip) per_ip GROUP BY proxy_id, cycle_type) ipw ON ipw.proxy_id = s.proxy_id AND ipw.cycle_type = s.cycle_type WHERE $__timeFilter(s.bucket_start) AND s.is_complete >= ${completeness} AND s.server_name IN (${server:sqlstring}) AND s.cycle_type IN (${cycle_type:sqlstring}) GROUP BY s.proxy_id, s.cycle_type, ipw.distinct_ips_window, ipw.duplicate_ip_pct ORDER BY ipw.distinct_ips_window ASC, wasted_pct DESC",
          "refId": "A"
        }
      ],
      "title": "Outliers — Per Device / Cycle Type (sorted by Wasted % then Anomaly %)",
      "type": "table"
    }
