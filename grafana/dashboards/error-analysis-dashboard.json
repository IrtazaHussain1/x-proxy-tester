        {
          "datasource": {
            "type": "mysql",
            "uid": "xproxy-tester-mysql"
          },
          "format": "table",
          "rawSql": "SELECT\n  p.name,\n  p.device_id,\n  p.location,\n  p.version,\n  SUM(s.failure_count)                                                         AS error_count,\n  SUM(s.total_requests)                                                        AS total_requests,\n  COALESCE(SUM(s.failure_count) * 100.0 / NULLIF(SUM(s.total_requests), 0), 0) AS error_rate\nFROM proxies p\nJOIN proxy_requests_5min_summary s ON p.device_id = s.proxy_id\nWHERE $__timeFilter(s.window_start)\n  AND p.location IN ($location)\nGROUP BY p.device_id, p.name, p.location, p.version\nHAVING error_count > 0\nORDER BY error_count DESC\nLIMIT 20",
          "refId": "A"
        }
