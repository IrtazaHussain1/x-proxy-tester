          "rawSql": "SELECT\n  s.window_start AS time,\n  COALESCE(SUM(s.failure_count) * 100.0 / NULLIF(SUM(s.total_requests), 0), 0) AS error_rate\nFROM proxy_requests_5min_summary s\nJOIN proxies p ON s.proxy_id = p.device_id\nWHERE $__timeFilter(s.window_start)\n  AND p.location IN ($location)\nGROUP BY s.window_start\nORDER BY s.window_start",
