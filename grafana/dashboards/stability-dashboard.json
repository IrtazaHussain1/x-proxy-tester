            "uid": "xproxy-tester-mysql"
          },
          "format": "time_series",
          "rawSql": "SELECT\n  UNIX_TIMESTAMP(DATE_FORMAT(updated_at, '%Y-%m-%d %H:%i:00')) as time_sec,\n  COUNT(CASE WHEN stability_status = 'Stable' THEN 1 END) as stable,\n  COUNT(CASE WHEN stability_status = 'UnstableHourly' THEN 1 END) as unstable_hourly,\n  COUNT(CASE WHEN stability_status = 'UnstableDaily' THEN 1 END) as unstable_daily\nFROM proxies\nWHERE active = true AND $__timeFilter(updated_at) AND location IN ($location)\nGROUP BY time_sec\nORDER BY time_sec",
          "refId": "A"
        }
      ],
      "title": "Stability Trend Over Time",
      "type": "timeseries"
