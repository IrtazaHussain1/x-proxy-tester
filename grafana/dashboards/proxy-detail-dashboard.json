          "format": "table",
          "rawSql": "SELECT\n  DATE_FORMAT(pr.rotation_cycle_started_at, '%Y-%m-%d %H:%i:%s') as cycle_time,\n  COUNT(*) as total_requests,\n  COUNT(CASE WHEN pr.status = 'SUCCESS' THEN 1 END) as success_count,\n  COUNT(CASE WHEN pr.status != 'SUCCESS' THEN 1 END) as failure_count,\n  COUNT(CASE WHEN pr.ip_changed = true THEN 1 END) as ip_changes,\n  COUNT(CASE WHEN pr.ip_changed = true THEN 1 END) * 100.0 / COUNT(*) as ip_change_rate,\n  AVG(pr.response_time_ms) as avg_response_time_ms\nFROM proxy_requests pr\nWHERE pr.rotation_cycle_started_at IS NOT NULL\n  AND pr.source = 'periodic_rotation'\n  AND pr.source IN ($source)\n  AND $__timeFilter(pr.rotation_cycle_started_at)\n  AND pr.proxy_id IN ($proxy)\nGROUP BY pr.rotation_cycle_started_at\nORDER BY cycle_time DESC\nLIMIT $limit"
        }
