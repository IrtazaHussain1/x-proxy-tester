      "targets": [
        {
          "datasource": {
            "type": "mysql",
            "uid": "xproxy-tester-mysql"
          },
          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "WITH phone_stats AS (SELECT p.device_id, CONCAT(p.name, ' [', p.device_id, ']') as phone, COUNT(*) as total_requests, ROUND(COUNT(CASE WHEN r.status = 'SUCCESS' THEN 1 END) * 100.0 / NULLIF(COUNT(*), 0), 2) as uptime_pct, ROUND(AVG(r.response_time_ms), 0) as avg_response_ms, SUM(CASE WHEN r.ip_changed = 1 THEN 1 ELSE 0 END) as ip_rotations, GREATEST(1, TIMESTAMPDIFF(HOUR, MIN(r.timestamp), MAX(r.timestamp)) + 1) as active_hours_estimated FROM proxy_requests r JOIN proxies p ON r.proxy_id = p.device_id WHERE $__timeFilter(r.timestamp) AND p.location IN ($location) GROUP BY p.device_id, p.name) SELECT phone, total_requests, uptime_pct, avg_response_ms, ip_rotations, ROUND(ip_rotations / NULLIF(active_hours_estimated, 0), 2) as rotations_per_active_hour, ROUND((100 - uptime_pct) * 0.6 + LEAST(avg_response_ms / 100.0, 40) * 0.3 + GREATEST(0, 5 - (ip_rotations / NULLIF(active_hours_estimated, 1))) * 2.0, 2) as unstable_score FROM phone_stats WHERE total_requests >= 20 ORDER BY unstable_score DESC LIMIT 25",
          "refId": "A",
          "sql": {
            "columns": [
              {
                "parameters": [],
                "type": "function"
              }
            ],
            "groupBy": [
              {
                "property": {
                  "type": "string"
                },
                "type": "groupBy"
              }
            ],
            "limit": 50
          }
        }
      ],
      "title": "Top Unstable Phones Leaderboard",
      "type": "table"
    }
