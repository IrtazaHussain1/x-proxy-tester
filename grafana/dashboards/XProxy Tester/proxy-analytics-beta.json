      "targets": [
        {
          "datasource": {
            "type": "mysql",
            "uid": "xproxy-tester-mysql"
          },
          "format": "table",
          "rawSql": "WITH base_proxies AS (SELECT p.device_id as proxy_id, p.location, CASE WHEN UPPER(TRIM(p.name)) REGEXP 'S[0-9]{1,3}[[:space:]_-]*P[0-9]+' THEN REGEXP_SUBSTR(REGEXP_SUBSTR(UPPER(TRIM(p.name)), 'S[0-9]{1,3}[[:space:]_-]*P[0-9]+'), 'S[0-9]{1,3}') WHEN UPPER(TRIM(p.name)) REGEXP '^S[0-9]{1,3}[[:space:]_-]+[0-9]+' THEN REGEXP_SUBSTR(UPPER(TRIM(p.name)), '^S[0-9]{1,3}') ELSE 'Unknown' END as server FROM proxies p WHERE p.location IN ($location)), total_pool AS (SELECT bp.location, bp.server, COUNT(*) as total_phones FROM base_proxies bp GROUP BY bp.location, bp.server), active_proxy_ids AS (SELECT DISTINCT r.proxy_id FROM proxy_requests r WHERE $__timeFilter(r.timestamp)), active_pool AS (SELECT bp.location, bp.server, COUNT(*) as active_phones FROM active_proxy_ids ap JOIN base_proxies bp ON bp.proxy_id = ap.proxy_id GROUP BY bp.location, bp.server) SELECT t.location, t.server, COALESCE(a.active_phones, 0) as active_phones, t.total_phones, ROUND(COALESCE(a.active_phones, 0) * 100.0 / NULLIF(t.total_phones, 0), 2) as saturation_pct FROM total_pool t LEFT JOIN active_pool a ON a.location = t.location AND a.server = t.server ORDER BY saturation_pct DESC, t.location, t.server",
          "refId": "A"
        }
      ],
      "title": "Location/Server Saturation",
      "type": "table"
    },
