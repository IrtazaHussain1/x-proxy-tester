      "pluginVersion": "12.3.0",
      "targets": [
        {
          "datasource": {
            "type": "mysql",
            "uid": "xproxy-tester-mysql"
          },
          "format": "table",
          "rawSql": "WITH bucketed AS (\n  SELECT\n    proxy_id,\n    FLOOR(UNIX_TIMESTAMP(timestamp) / 300) AS bucket,\n    MIN(timestamp) AS bucket_ts,\n    COUNT(*) AS bucket_total,\n    SUM(CASE WHEN status != 'SUCCESS' THEN 1 ELSE 0 END) AS bucket_failed\n  FROM proxy_requests\n  WHERE $__timeFilter(timestamp)\n  GROUP BY proxy_id, FLOOR(UNIX_TIMESTAMP(timestamp) / 300)\n),\nrecent AS (\n  SELECT\n    proxy_id,\n    SUM(bucket_total) AS total_req,\n    SUM(bucket_failed) AS failed_req,\n    MAX(bucket_ts) AS last_seen\n  FROM bucketed\n  GROUP BY proxy_id\n),\ngaps AS (\n  SELECT proxy_id, MAX(gap_min) AS max_gap_min\n  FROM (\n    SELECT proxy_id,\n      TIMESTAMPDIFF(MINUTE,\n        LAG(bucket_ts) OVER (PARTITION BY proxy_id ORDER BY bucket_ts),\n        bucket_ts\n      ) AS gap_min\n    FROM bucketed\n  ) g\n  WHERE gap_min IS NOT NULL\n  GROUP BY proxy_id\n),\ndup_ips AS (\n  SELECT last_ip\n  FROM proxies\n  WHERE last_ip IS NOT NULL AND last_ip != ''\n  GROUP BY last_ip\n  HAVING COUNT(*) > 1\n)\nSELECT\n  COALESCE(p.name, p.device_id) as device_name,\n  CASE\n    WHEN UPPER(TRIM(p.name)) REGEXP '^S[0-9]{1,3}(P[0-9]+|[[:space:]_-]+P[0-9]+)$'\n      THEN CONCAT('S', REGEXP_SUBSTR(UPPER(TRIM(p.name)), '[0-9]+'))\n    ELSE 'Unknown'\n  END as server,\n  p.stability_status,\n  p.rotation_status,\n  p.last_ip,\n  CASE WHEN p.last_ip IN (SELECT last_ip FROM dup_ips) THEN 'YES' ELSE '' END as duplicate_ip,\n  COALESCE(ROUND(r.failed_req * 100.0 / NULLIF(r.total_req, 0), 1), 0) as error_rate_24h_pct,\n  COALESCE(r.total_req, 0) as requests_24h,\n  COALESCE(DATEDIFF(NOW(), p.last_rotation_at), 999) as days_since_rotation,\n  COALESCE(g.max_gap_min, 0) as max_gap_min_24h,\n  r.last_seen\nFROM proxies p\nLEFT JOIN recent r ON p.device_id = r.proxy_id\nLEFT JOIN gaps g ON p.device_id = g.proxy_id\nWHERE p.active = true\nORDER BY error_rate_24h_pct DESC, days_since_rotation DESC",
          "refId": "A"
        }
      ],
      "title": "Proxy Triage — All Active Proxies",
      "type": "table"
    }
