      "targets": [
        {
          "datasource": {
            "type": "mysql",
            "uid": "xproxy-tester-mysql"
          },
          "format": "table",
          "rawSql": "SELECT COUNT(DISTINCT proxy_id) as value\nFROM (\n  SELECT proxy_id,\n    SUM(failed) * 100.0 / NULLIF(SUM(total), 0) as err_rate\n  FROM (\n    SELECT proxy_id,\n      COUNT(*) as total,\n      SUM(CASE WHEN status != 'SUCCESS' THEN 1 ELSE 0 END) as failed\n    FROM proxy_requests\n    WHERE $__timeFilter(timestamp)\n    GROUP BY proxy_id, FLOOR(UNIX_TIMESTAMP(timestamp) / 300)\n  ) b\n  GROUP BY proxy_id\n  HAVING err_rate > 20\n) t",
          "refId": "A"
        }
      ],
      "title": "Proxies — Error Rate > 20% (24h)",
      "type": "stat"
    },
