      "targets": [
        {
          "datasource": {
            "type": "mysql",
            "uid": "xproxy-tester-mysql"
          },
          "format": "time_series",
          "rawSql": "SELECT UNIX_TIMESTAMP(s.day) AS time_sec, COUNT(DISTINCT CASE WHEN s.total_requests > 0 THEN s.proxy_id END) AS active_proxies, COUNT(DISTINCT CASE WHEN s.success_count > 0 THEN s.proxy_id END) AS working_proxies, ROUND(COUNT(DISTINCT CASE WHEN s.success_count > 0 THEN s.proxy_id END) * 100.0 / NULLIF(COUNT(DISTINCT CASE WHEN s.total_requests > 0 THEN s.proxy_id END), 0), 2) AS working_ratio_pct FROM proxy_requests_daily_summary s WHERE s.day >= DATE($__timeFrom()) AND s.day <= DATE($__timeTo()) AND s.location IN ($location) AND COALESCE(s.server_name, 'UNKNOWN') IN ($server) AND s.proxy_id IN ($phone) GROUP BY s.day ORDER BY s.day",
          "refId": "A"
        }
      ],
      "title": "Active vs Working Proxies Trend",
      "type": "timeseries"
    },
