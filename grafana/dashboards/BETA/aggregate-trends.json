          },
          "format": "time_series",
          "rawSql": "WITH daily_combos AS (SELECT DATE(captured_at) AS day, last_ip, GROUP_CONCAT(DISTINCT server_label ORDER BY server_label SEPARATOR ' + ') AS combo FROM duplicate_ip_snapshot_servers WHERE $__timeFilter(captured_at) GROUP BY DATE(captured_at), last_ip HAVING COUNT(DISTINCT server_label) > 1) SELECT UNIX_TIMESTAMP(day) AS time_sec, COUNT(DISTINCT last_ip) AS cross_server_dup_ips, COUNT(DISTINCT combo) AS unique_server_combos, ROUND(COUNT(DISTINCT last_ip) * 1.0 / NULLIF(COUNT(DISTINCT combo), 0), 2) AS avg_dup_ips_per_combo FROM daily_combos GROUP BY day ORDER BY day",
          "refId": "A"
        }
      ],
      "title": "Most Repeated Unique Server Combinations (Trend)",
      "type": "timeseries"
    },
