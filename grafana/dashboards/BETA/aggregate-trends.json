      "targets": [
        {
          "datasource": {
            "type": "mysql",
            "uid": "xproxy-tester-mysql"
          },
          "format": "table",
          "rawSql": "WITH daily AS (SELECT DATE(captured_at) AS day, last_ip, TRIM(server_label) AS server_label FROM duplicate_ip_snapshot_servers WHERE $__timeFilter(captured_at) GROUP BY DATE(captured_at), last_ip, TRIM(server_label)), pairs AS (SELECT a.day, LEAST(a.server_label, b.server_label) AS server_a, GREATEST(a.server_label, b.server_label) AS server_b, a.last_ip FROM daily a JOIN daily b ON a.day = b.day AND a.last_ip = b.last_ip AND a.server_label <> b.server_label) SELECT p.day AS time, CONCAT(p.server_a, ' + ', p.server_b) AS server_pair, COUNT(DISTINCT p.last_ip) AS shared_ips FROM pairs p GROUP BY p.day, p.server_a, p.server_b ORDER BY p.day",
          "refId": "A"
        }
