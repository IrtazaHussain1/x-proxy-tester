          "format": "time_series",
          "rawSql": "SELECT UNIX_TIMESTAMP(s.day) AS time_sec, SUM(s.rotation_count) AS rotation_requests_per_day, SUM(s.ip_rotation_periodic_success_count + s.ip_rotation_inactive_proxy_success_count + s.ip_rotation_continuous_success_count) AS rotation_success_count, SUM(s.ip_rotation_periodic_failure_count + s.ip_rotation_inactive_proxy_failure_count + s.ip_rotation_continuous_failure_count) AS rotation_failure_count, SUM(s.ip_change_count) AS ip_changes_per_day, ROUND(SUM(s.ip_rotation_periodic_success_count + s.ip_rotation_inactive_proxy_success_count + s.ip_rotation_continuous_success_count) * 100.0 / NULLIF(SUM(s.ip_rotation_periodic_success_count + s.ip_rotation_inactive_proxy_success_count + s.ip_rotation_continuous_success_count + s.ip_rotation_periodic_failure_count + s.ip_rotation_inactive_proxy_failure_count + s.ip_rotation_continuous_failure_count), 0), 2) AS rotation_success_pct, ROUND(SUM(s.ip_rotation_periodic_success_count) * 100.0 / NULLIF(SUM(s.ip_rotation_periodic_success_count + s.ip_rotation_periodic_failure_count), 0), 2) AS periodic_rotation_success_pct, ROUND(SUM(s.ip_change_count) * 100.0 / NULLIF(SUM(s.rotation_count), 0), 2) AS change_per_request_pct FROM proxy_requests_daily_summary s WHERE s.day >= DATE($__timeFrom()) AND s.day <= DATE($__timeTo()) AND s.location IN (${location:sqlstring}) AND COALESCE(s.server_name, 'UNKNOWN') IN (${server:sqlstring}) AND s.proxy_id IN (${phone:sqlstring}) GROUP BY s.day ORDER BY s.day",
          "refId": "A"
        }
      ],
