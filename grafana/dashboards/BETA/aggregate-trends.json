          "format": "time_series",
          "rawSql": "WITH daily_servers AS (SELECT DATE(s.captured_at) AS day, COUNT(DISTINCT s.last_ip) AS duplicate_ips, COUNT(DISTINCT s.server_label) AS affected_servers FROM duplicate_ip_snapshot_servers s WHERE $__timeFilter(s.captured_at) GROUP BY DATE(s.captured_at)), daily_rows AS (SELECT DATE(r.captured_at) AS day, SUM(r.phones_on_same_ip) AS impacted_phones FROM duplicate_ip_snapshot_rows r WHERE $__timeFilter(r.captured_at) GROUP BY DATE(r.captured_at)) SELECT UNIX_TIMESTAMP(ds.day) AS time_sec, ds.duplicate_ips, COALESCE(dr.impacted_phones, 0) AS impacted_phones, ds.affected_servers, ROUND(COALESCE(dr.impacted_phones, 0) * 1.0 / NULLIF(ds.duplicate_ips, 0), 2) AS impacted_phones_per_dup_ip FROM daily_servers ds LEFT JOIN daily_rows dr ON dr.day = ds.day ORDER BY ds.day",
          "refId": "A"
        }
      ],
      "title": "Groups Getting More Duplicate IPs (Trend)",
