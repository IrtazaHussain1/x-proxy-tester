{
  "uid": "overview-filtered",
  "title": "XProxy Tester - Overview_Filtered",
  "tags": [
    "x-proxy-tester",
    "overview",
    "filtered"
  ],
  "timezone": "browser",
  "schemaVersion": 38,
  "version": 1,
  "refresh": "1m",
  "panels": [
    {
      "id": 1,
      "gridPos": { "h": 4, "w": 4, "x": 0, "y": 0 },
      "type": "stat",
      "title": "Total Active Proxies",
      "targets": [
        {
          "datasource": { "type": "mysql", "uid": "xproxy-tester-mysql" },
          "rawSql": "SELECT COUNT(*) as value FROM proxies WHERE active = true AND location IN ($location)",
          "format": "table"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "thresholds" },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "value": null, "color": "green" },
              { "value": 0, "color": "red" }
            ]
          }
        }
      }
    },
    {
      "id": 2,
      "gridPos": { "h": 4, "w": 4, "x": 4, "y": 0 },
      "type": "stat",
      "title": "Stable Proxies",
      "targets": [
        {
          "datasource": { "type": "mysql", "uid": "xproxy-tester-mysql" },
          "rawSql": "SELECT COUNT(*) as value FROM proxies WHERE active = true AND stability_status = 'Stable' AND location IN ($location)",
          "format": "table"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "thresholds" },
          "thresholds": {
            "mode": "absolute",
            "steps": [{ "value": null, "color": "green" }]
          }
        }
      }
    },
    {
      "id": 10,
      "gridPos": { "h": 4, "w": 4, "x": 8, "y": 0 },
      "type": "stat",
      "title": "Unstable Proxies",
      "targets": [
        {
          "datasource": { "type": "mysql", "uid": "xproxy-tester-mysql" },
          "rawSql": "SELECT COUNT(*) as value FROM proxies WHERE active = true AND stability_status IN ('UnstableHourly', 'UnstableDaily') AND location IN ($location)",
          "format": "table"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "thresholds" },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "value": null, "color": "green" },
              { "value": 1, "color": "yellow" },
              { "value": 10, "color": "red" }
            ]
          }
        }
      }
    },
    {
      "id": 3,
      "gridPos": { "h": 4, "w": 4, "x": 12, "y": 0 },
      "type": "stat",
      "title": "Success Rate",
      "targets": [
        {
          "datasource": { "type": "mysql", "uid": "xproxy-tester-mysql" },
          "rawSql": "SELECT COUNT(CASE WHEN r.status = 'SUCCESS' THEN 1 END) * 100.0 / COUNT(*) as value FROM proxy_requests r JOIN proxies p ON r.proxy_id = p.device_id WHERE $__timeFilter(r.timestamp) AND p.location IN ($location)",
          "format": "table"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "decimals": 2,
          "color": { "mode": "thresholds" },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "value": null, "color": "red" },
              { "value": 50, "color": "yellow" },
              { "value": 90, "color": "green" }
            ]
          }
        }
      }
    },
    {
      "id": 4,
      "gridPos": { "h": 4, "w": 4, "x": 16, "y": 0 },
      "type": "stat",
      "title": "Avg DL Speed",
      "targets": [
        {
          "datasource": { "type": "mysql", "uid": "xproxy-tester-mysql" },
          "rawSql": "SELECT AVG(download_speed_mbps) as value FROM proxies WHERE active = true AND location IN ($location)",
          "format": "table"
        }
      ]
    },
    {
      "id": 5,
      "gridPos": { "h": 4, "w": 4, "x": 20, "y": 0 },
      "type": "stat",
      "title": "Avg UL Speed",
      "targets": [
        {
          "datasource": { "type": "mysql", "uid": "xproxy-tester-mysql" },
          "rawSql": "SELECT AVG(upload_speed_mbps) as value FROM proxies WHERE active = true AND location IN ($location)",
          "format": "table"
        }
      ]
    },
    {
      "id": 11,
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 4 },
      "type": "timeseries",
      "title": "Success Rate Over Time",
      "targets": [
        {
          "datasource": { "type": "mysql", "uid": "xproxy-tester-mysql" },
          "rawSql": "SELECT UNIX_TIMESTAMP(DATE_FORMAT(r.timestamp, '%Y-%m-%d %H:%i:00')) as time_sec, COUNT(CASE WHEN r.status = 'SUCCESS' THEN 1 END) * 100.0 / COUNT(*) as success_rate FROM proxy_requests r JOIN proxies p ON r.proxy_id = p.device_id WHERE $__timeFilter(r.timestamp) AND p.location IN ($location) GROUP BY time_sec ORDER BY time_sec",
          "format": "time_series"
        }
      ]
    },
    {
      "id": 12,
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 4 },
      "type": "timeseries",
      "title": "Request Volume",
      "targets": [
        {
          "datasource": { "type": "mysql", "uid": "xproxy-tester-mysql" },
          "rawSql": "SELECT UNIX_TIMESTAMP(DATE_FORMAT(r.timestamp, '%Y-%m-%d %H:%i:00')) as time_sec, COUNT(*) as request_count FROM proxy_requests r JOIN proxies p ON r.proxy_id = p.device_id WHERE $__timeFilter(r.timestamp) AND p.location IN ($location) GROUP BY time_sec ORDER BY time_sec",
          "format": "time_series"
        }
      ]
    },
    {
      "id": 13,
      "gridPos": { "h": 8, "w": 8, "x": 0, "y": 12 },
      "type": "piechart",
      "title": "Stability Status Distribution",
      "targets": [
        {
          "datasource": { "type": "mysql", "uid": "xproxy-tester-mysql" },
          "rawSql": "SELECT stability_status as metric, COUNT(*) as value FROM proxies WHERE active = true AND location IN ($location) GROUP BY stability_status",
          "format": "table"
        }
      ]
    },
    {
      "id": 14,
      "gridPos": { "h": 8, "w": 16, "x": 8, "y": 12 },
      "type": "timeseries",
      "title": "Average Response Time Trend",
      "targets": [
        {
          "datasource": { "type": "mysql", "uid": "xproxy-tester-mysql" },
          "rawSql": "SELECT UNIX_TIMESTAMP(DATE_FORMAT(r.timestamp, '%Y-%m-%d %H:%i:00')) as time_sec, AVG(r.response_time_ms) as avg_response_time FROM proxy_requests r JOIN proxies p ON r.proxy_id = p.device_id WHERE $__timeFilter(r.timestamp) AND p.location IN ($location) AND r.response_time_ms IS NOT NULL GROUP BY time_sec ORDER BY time_sec",
          "format": "time_series"
        }
      ]
    }
  ],
  "templating": {
    "list": [
      {
        "name": "location",
        "type": "query",
        "datasource": { "type": "mysql", "uid": "xproxy-tester-mysql" },
        "query": "SELECT DISTINCT location FROM proxies WHERE location IS NOT NULL",
        "refresh": 1,
        "multi": true,
        "includeAll": true,
        "current": { "text": "All", "value": "$__all" },
        "options": []
      }
    ]
  },
  "time": { "from": "now-30m", "to": "now" },
  "editable": true
}
