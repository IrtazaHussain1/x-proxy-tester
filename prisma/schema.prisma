generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model Proxy {
  deviceId          String   @id @map("device_id") @db.VarChar(255)
  deviceApiId       Int?     @map("device_api_id")
  name              String
  model             String?
  location          String?
  host              String
  port              Int
  protocol          String   @default("http")
  username          String?
  password          String?
  active            Boolean  @default(true)
  ipAddress         String?  @map("ip_address") @db.VarChar(45)
  wsStatus          String?  @map("ws_status")
  proxyStatus       String?  @map("proxy_status")
  country           String?
  state             String?
  city              String?
  street            String?
  longitude         Float?
  latitude          Float?
  relayServerId     Int?     @map("relay_server_id")
  relayServerIpAddress String? @map("relay_server_ip_address") @db.VarChar(45)
  downloadNetSpeed  Float?   @map("download_net_speed")
  uploadNetSpeed    Float?   @map("upload_net_speed")
  lastIpRotation    String?  @map("last_ip_rotation")
  extra             String?  @map("extra") @db.Text // Base64 encoded JSON from API
  version           String?  @map("version") @db.VarChar(50) // Extracted from extra.version
  lastIp            String?  @map("last_ip")
  sameIpCount       Int      @default(0) @map("same_ip_count")
  stabilityStatus   String   @default("Unknown") @map("stability_status")
  rotationStatus    String?  @default("Unknown") @map("rotation_status")
  lastRotationAt    DateTime? @map("last_rotation_at")
  rotationCount     Int      @default(0) @map("rotation_count")
  createdAt         DateTime  @default(now()) @map("created_at")
  updatedAt         DateTime  @updatedAt @map("updated_at")


  speedTests      SpeedTest[]
  requests        ProxyRequest[]
  ipRotations     IpRotation[]

  @@index([active])
  @@index([stabilityStatus])
  @@index([rotationStatus])
  @@index([updatedAt])
  @@index([proxyStatus])
  @@index([location])
  @@index([location, active, deviceId])
  @@index([country])
  @@index([state])
  @@index([city])
  @@map("proxies")
}

model RotationCycle {
  id              String        @id @default(uuid())
  cycleType       String        @map("cycle_type") @db.VarChar(50)
  cycleTimestamp  DateTime      @map("cycle_timestamp")
  totalProxies    Int           @default(0) @map("total_proxies")
  successfulCount Int           @default(0) @map("successful_count")
  failedCount     Int           @default(0) @map("failed_count")
  pendingCount    Int           @default(0) @map("pending_count")
  status          String        @db.VarChar(50)
  createdAt       DateTime      @default(now()) @map("created_at")
  updatedAt       DateTime      @updatedAt @map("updated_at")

  rotations       IpRotation[]

  @@index([cycleTimestamp])
  @@index([status])
  @@index([cycleType])
  @@index([cycleType, cycleTimestamp])
  @@map("rotation_cycles")
}

model IpRotation {
  id                  String        @id @default(uuid())
  cycleId             String        @map("cycle_id") @db.VarChar(36)
  proxyId             String        @map("proxy_id") @db.VarChar(255)
  rotationTimestamp   DateTime      @map("rotation_timestamp")
  rotationType        String        @map("rotation_type") @db.VarChar(50)
  commandSentAt       DateTime      @map("command_sent_at")
  commandResponse     Json?         @map("command_response")
  ipBefore            String?       @map("ip_before") @db.VarChar(45)
  ipAfter             String?       @map("ip_after") @db.VarChar(45)
  statusBefore        String?       @map("status_before") @db.VarChar(50)
  statusAfter         String?       @map("status_after") @db.VarChar(50)
  wsStatusBefore      String?       @map("ws_status_before") @db.VarChar(50)
  wsStatusAfter       String?       @map("ws_status_after") @db.VarChar(50)
  success             Boolean       @default(false)
  verificationMethod  String?      @map("verification_method") @db.VarChar(50)
  verifiedAt          DateTime?     @map("verified_at")
  waitTimeMs          Int?          @map("wait_time_ms")
  rotationDurationMs  Int?          @map("rotation_duration_ms")
  retryCount          Int           @default(0) @map("retry_count")
  errorMessage        String?       @map("error_message") @db.Text
  deviceMetadata      Json?         @map("device_metadata")
  createdAt           DateTime      @default(now()) @map("created_at")
  updatedAt           DateTime      @updatedAt @map("updated_at")

  cycle               RotationCycle @relation(fields: [cycleId], references: [id], onDelete: Cascade)
  proxy               Proxy         @relation(fields: [proxyId], references: [deviceId], onDelete: Cascade)

  @@index([cycleId])
  @@index([proxyId])
  @@index([rotationTimestamp])
  @@index([success])
  @@index([cycleId, rotationTimestamp])
  @@index([proxyId, rotationTimestamp])
  @@map("ip_rotations")
}

model ProxyRequest {
  id             String   @id @default(uuid())
  proxyId        String   @map("proxy_id") @db.VarChar(255)
  timestamp      DateTime @default(now())
  targetUrl      String   @map("target_url")
  status         String
  httpStatusCode Int?     @map("http_status_code")
  responseTimeMs Int?     @map("response_time_ms")
  expectedIp     String?  @map("expected_ip")
  outboundIp     String?  @map("outbound_ip")
  ipChanged      Boolean  @default(false) @map("ip_changed")
  errorType      String?  @map("error_type")
  errorMessage   String?  @map("error_message")
  source         String?  @default("continuous") @map("source")
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")
  downloadSpeedMbps Float?   @map("download_speed_mbps")
  uploadSpeedMbps   Float?   @map("upload_speed_mbps")

  proxy Proxy @relation(fields: [proxyId], references: [deviceId], onDelete: Cascade)

  @@index([proxyId, timestamp])
  @@index([proxyId, timestamp, source], map: "idx_proxy_requests_proxy_timestamp_source")
  @@index([timestamp])
  @@index([outboundIp])
  @@map("proxy_requests")
}

model SpeedTest {
  id                String   @id @default(uuid())
  proxyId           String   @map("proxy_id") @db.VarChar(255)
  timestamp         DateTime @default(now())
  downloadSpeedMbps Float?   @map("download_speed_mbps")
  uploadSpeedMbps   Float?   @map("upload_speed_mbps")
  latencyMs         Int?     @map("latency_ms")
  error             String?
  // Device status at time of test (captured from device API)
  deviceActive      Boolean? @map("device_active")
  wsStatus          String?  @map("ws_status")
  proxyStatus       String?  @map("proxy_status")
  createdAt         DateTime @default(now()) @map("created_at")

  proxy Proxy @relation(fields: [proxyId], references: [deviceId], onDelete: Cascade)

  @@index([proxyId, timestamp])
  @@index([timestamp, proxyId])
  @@index([timestamp])
  @@index([deviceActive])
  @@index([wsStatus])
  @@index([proxyStatus])
  @@map("speed_tests")
}

/// Pre-aggregated daily summary of proxy_requests, one row per proxy per day.
/// Raw proxy_requests are deleted after 30 days; this table is kept forever.
/// Populated nightly at 1 AM by the daily-aggregation service.
model ProxyRequestsDailySummary {
  day                  DateTime @db.Date
  proxyId              String   @map("proxy_id") @db.VarChar(255)
  deviceName           String?  @map("device_name") @db.VarChar(255)
  serverName           String?  @map("server_name") @db.VarChar(32)
  location             String?  @db.VarChar(255)
  relayServerId        String?  @map("relay_server_id") @db.VarChar(255)
  relayServerIp        String?  @map("relay_server_ip") @db.VarChar(45)

  totalRequests        Int      @default(0) @map("total_requests")
  successCount         Int      @default(0) @map("success_count")
  failureCount         Int      @default(0) @map("failure_count")
  successRatePct       Decimal? @map("success_rate_pct") @db.Decimal(5, 2)

  avgResponseTimeMs    Decimal? @map("avg_response_time_ms") @db.Decimal(10, 2)
  minResponseTimeMs    Int?     @map("min_response_time_ms")
  maxResponseTimeMs    Int?     @map("max_response_time_ms")
  p50ResponseTimeMs    Int?     @map("p50_response_time_ms")
  p95ResponseTimeMs    Int?     @map("p95_response_time_ms")
  p99ResponseTimeMs    Int?     @map("p99_response_time_ms")

  timeoutCount         Int      @default(0) @map("timeout_count")
  connectionErrorCount Int      @default(0) @map("connection_error_count")
  httpErrorCount       Int      @default(0) @map("http_error_count")
  dnsErrorCount        Int      @default(0) @map("dns_error_count")

  rotationCount        Int      @default(0) @map("rotation_count")
  ipRotationPeriodicSuccessCount Int      @default(0) @map("ip_rotation_periodic_success_count")
  ipRotationPeriodicFailureCount Int      @default(0) @map("ip_rotation_periodic_failure_count")
  ipRotationContinuousSuccessCount Int    @default(0) @map("ip_rotation_continuous_success_count")
  ipRotationContinuousFailureCount Int    @default(0) @map("ip_rotation_continuous_failure_count")

  avgDownloadSpeedMbps Decimal? @map("avg_download_speed_mbps") @db.Decimal(10, 4)
  avgUploadSpeedMbps   Decimal? @map("avg_upload_speed_mbps") @db.Decimal(10, 4)
  maxDownloadSpeedMbps Decimal? @map("max_download_speed_mbps") @db.Decimal(10, 4)
  maxUploadSpeedMbps   Decimal? @map("max_upload_speed_mbps") @db.Decimal(10, 4)
  minDownloadSpeedMbps Decimal? @map("min_download_speed_mbps") @db.Decimal(10, 4)
  minUploadSpeedMbps   Decimal? @map("min_upload_speed_mbps") @db.Decimal(10, 4)

  uniqueIpsCount       Int      @default(0) @map("unique_ips_count")
  ipDiversityScore     Decimal? @map("ip_diversity_score") @db.Decimal(5, 2)
  ipHistoryJson        Json?    @map("ip_history_json")
  ipChangeCount        Int      @default(0) @map("ip_change_count")
  firstIp              String?  @map("first_ip") @db.VarChar(45)
  lastIp               String?  @map("last_ip") @db.VarChar(45)
  mostUsedIp           String?  @map("most_used_ip") @db.VarChar(45)
  mostUsedIpCount      Int      @default(0) @map("most_used_ip_count")

  createdAt            DateTime @default(now()) @map("created_at")
  updatedAt            DateTime @updatedAt @map("updated_at")

  @@id([day, proxyId])
  @@index([day])
  @@index([proxyId, day])
  @@index([location])
  @@index([serverName])
  @@index([relayServerId])
  @@index([day, relayServerId])
  @@map("proxy_requests_daily_summary")
}

/// One row per duplicate shared IP for one capture instant (group by captured_at + proxy_status_scope = one snapshot).
model DuplicateIpSnapshotRow {
  id               BigInt   @id @default(autoincrement())
  capturedAt       DateTime @map("captured_at")
  proxyStatusScope String   @map("proxy_status_scope") @db.VarChar(16)
  lastIp           String   @map("last_ip") @db.VarChar(45)
  location         String?  @db.Text
  allServersOnIp   String?  @map("all_servers_on_ip") @db.Text
  phonesOnSameIp   Int      @map("phones_on_same_ip")
  siblingPhones    String?  @map("sibling_phones") @db.Text
  deviceIds        String?  @map("device_ids") @db.Text

  @@unique([capturedAt, proxyStatusScope, lastIp])
  @@index([capturedAt, proxyStatusScope])
  @@index([lastIp, capturedAt])
  @@map("duplicate_ip_snapshot_rows")
}

/// Normalized server labels for one capture (same captured_at / scope as sibling rows).
model DuplicateIpSnapshotServer {
  id               BigInt   @id @default(autoincrement())
  capturedAt       DateTime @map("captured_at")
  proxyStatusScope String   @map("proxy_status_scope") @db.VarChar(16)
  lastIp           String   @map("last_ip") @db.VarChar(45)
  serverLabel      String   @map("server_label") @db.VarChar(64)

  @@unique([capturedAt, proxyStatusScope, lastIp, serverLabel])
  @@index([capturedAt, proxyStatusScope])
  @@index([lastIp, capturedAt])
  @@index([serverLabel, capturedAt])
  @@map("duplicate_ip_snapshot_servers")
}
