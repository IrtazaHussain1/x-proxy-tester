generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model Proxy {
  deviceId          String   @id @map("device_id") @db.VarChar(255)
  deviceApiId       Int?     @map("device_api_id")
  name              String
  model             String?
  location          String?
  host              String
  port              Int
  protocol          String   @default("http")
  username          String?
  password          String?
  active            Boolean  @default(true)
  ipAddress         String?  @map("ip_address") @db.VarChar(45)
  wsStatus          String?  @map("ws_status")
  proxyStatus       String?  @map("proxy_status")
  country           String?
  state             String?
  city              String?
  street            String?
  longitude         Float?
  latitude          Float?
  relayServerId     Int?     @map("relay_server_id")
  relayServerIpAddress String? @map("relay_server_ip_address") @db.VarChar(45)
  downloadNetSpeed  Float?   @map("download_net_speed")
  uploadNetSpeed    Float?   @map("upload_net_speed")
  lastIpRotation    String?  @map("last_ip_rotation")
  lastIp            String?  @map("last_ip")
  sameIpCount       Int      @default(0) @map("same_ip_count")
  stabilityStatus   String   @default("Unknown") @map("stability_status")
  rotationStatus    String?  @default("Unknown") @map("rotation_status")
  lastRotationAt    DateTime? @map("last_rotation_at")
  rotationCount     Int      @default(0) @map("rotation_count")
  createdAt         DateTime  @default(now()) @map("created_at")
  updatedAt         DateTime  @updatedAt @map("updated_at")


  speedTests      SpeedTest[]
  requests        ProxyRequest[]
  ipRotations     IpRotation[]

  @@index([active])
  @@index([stabilityStatus])
  @@index([rotationStatus])
  @@index([updatedAt])
  @@index([proxyStatus])
  @@index([country])
  @@index([state])
  @@index([city])
  @@map("proxies")
}

model RotationCycle {
  id              String        @id @default(uuid())
  cycleType       String        @map("cycle_type") @db.VarChar(50)
  cycleTimestamp  DateTime      @map("cycle_timestamp")
  totalProxies    Int           @default(0) @map("total_proxies")
  successfulCount Int           @default(0) @map("successful_count")
  failedCount     Int           @default(0) @map("failed_count")
  pendingCount    Int           @default(0) @map("pending_count")
  status          String        @db.VarChar(50)
  createdAt       DateTime      @default(now()) @map("created_at")
  updatedAt       DateTime      @updatedAt @map("updated_at")

  rotations       IpRotation[]

  @@index([cycleTimestamp])
  @@index([status])
  @@index([cycleType])
  @@index([cycleType, cycleTimestamp])
  @@map("rotation_cycles")
}

model IpRotation {
  id                  String        @id @default(uuid())
  cycleId             String        @map("cycle_id") @db.VarChar(36)
  proxyId             String        @map("proxy_id") @db.VarChar(255)
  rotationTimestamp   DateTime      @map("rotation_timestamp")
  rotationType        String        @map("rotation_type") @db.VarChar(50)
  commandSentAt       DateTime      @map("command_sent_at")
  commandResponse     Json?         @map("command_response")
  ipBefore            String?       @map("ip_before") @db.VarChar(45)
  ipAfter             String?       @map("ip_after") @db.VarChar(45)
  statusBefore        String?       @map("status_before") @db.VarChar(50)
  statusAfter         String?       @map("status_after") @db.VarChar(50)
  success             Boolean       @default(false)
  verificationMethod  String?      @map("verification_method") @db.VarChar(50)
  verifiedAt          DateTime?     @map("verified_at")
  waitTimeMs          Int?          @map("wait_time_ms")
  rotationDurationMs  Int?          @map("rotation_duration_ms")
  retryCount          Int           @default(0) @map("retry_count")
  errorMessage        String?       @map("error_message") @db.Text
  deviceMetadata      Json?         @map("device_metadata")
  createdAt           DateTime      @default(now()) @map("created_at")
  updatedAt           DateTime      @updatedAt @map("updated_at")

  cycle               RotationCycle @relation(fields: [cycleId], references: [id], onDelete: Cascade)
  proxy               Proxy         @relation(fields: [proxyId], references: [deviceId], onDelete: Cascade)

  @@index([cycleId])
  @@index([proxyId])
  @@index([rotationTimestamp])
  @@index([success])
  @@index([cycleId, rotationTimestamp])
  @@index([proxyId, rotationTimestamp])
  @@map("ip_rotations")
}

model ProxyRequest {
  id             String   @id @default(uuid())
  proxyId        String   @map("proxy_id") @db.VarChar(255)
  timestamp      DateTime @default(now())
  targetUrl      String   @map("target_url")
  status         String
  httpStatusCode Int?     @map("http_status_code")
  responseTimeMs Int?     @map("response_time_ms")
  expectedIp     String?  @map("expected_ip")
  outboundIp     String?  @map("outbound_ip")
  ipChanged      Boolean  @default(false) @map("ip_changed")
  errorType      String?  @map("error_type")
  errorMessage   String?  @map("error_message")
  source         String?  @default("continuous") @map("source")
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")
  downloadSpeedMbps Float?   @map("download_speed_mbps")
  uploadSpeedMbps   Float?   @map("upload_speed_mbps")

  proxy Proxy @relation(fields: [proxyId], references: [deviceId], onDelete: Cascade)

  @@index([proxyId, timestamp])
  @@index([timestamp])
  @@index([status])
  @@index([outboundIp])
  @@index([expectedIp])
  @@index([ipChanged])
  @@index([source])
  @@index([createdAt])
  @@index([updatedAt])
  @@map("proxy_requests")
}

model SpeedTest {
  id                String   @id @default(uuid())
  proxyId           String   @map("proxy_id") @db.VarChar(255)
  timestamp         DateTime @default(now())
  downloadSpeedMbps Float?   @map("download_speed_mbps")
  uploadSpeedMbps   Float?   @map("upload_speed_mbps")
  latencyMs         Int?     @map("latency_ms")
  error             String?
  createdAt         DateTime @default(now()) @map("created_at")

  proxy Proxy @relation(fields: [proxyId], references: [deviceId], onDelete: Cascade)

  @@index([proxyId, timestamp])
  @@index([timestamp])
  @@map("speed_tests")
}
